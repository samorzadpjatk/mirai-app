{
  "name": "@mirai-app/monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter='./packages/*'",
    "dev": "turbo run dev",
    "dev:backend": "turbo run dev --filter=@mirai-app/backend-server",
    "dev:notification-sender": "turbo run dev --filter=@mirai-app/notification-sender",
    "dev:native": "turbo run dev --filter=@mirai-app/native",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format:check": "turbo run format:check",
    "format:write": "turbo run format:write",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "clean": "turbo run clean && rm -rf node_modules",
    "postinstall": "cd packages/db && bun run db:generate",
    "prepare": "husky",
    "setup:dev": "bun run scripts/setup-dev.ts"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.28.6",
    "@babel/runtime": "^7.29.2",
    "@babel/types": "^7.29.0",
    "@commitlint/config-conventional": "^20.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@tsconfig/bun": "^1.0.10",
    "@types/bun": "^1.3.13",
    "@vitest/coverage-v8": "^3.0.0",
    "babel-jest": "^30.3.0",
    "babel-preset-expo": "^55.0.20",
    "eslint": "^9.39.3",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.1",
    "react-test-renderer": "19.1.0",
    "picocolors": "^1.1.1",
    "turbo": "^2.8.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^3.0.0"
  },
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "license": "AGPL-3.0",
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "overrides": {
    "@prisma/client": false,
    "prisma": false
  }
}
