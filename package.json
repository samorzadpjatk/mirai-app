{
  "name": "@mirai-app/monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:backend": "turbo run dev --filter=@mirai-app/backend-server",
    "dev:notification-sender": "turbo run dev --filter=@mirai-app/notification-sender",
    "dev:native": "turbo run dev --filter=@mirai-app/native",
    "dev:web": "turbo run dev --filter=@mirai-app/web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format:check": "turbo run format:check",
    "format:write": "turbo run format:write",
    "clean": "turbo run clean && rm -rf node_modules",
    "test": "bun test --test-name-pattern='^\\[UNIT\\]'",
    "test:unit": "bun test --test-name-pattern='^\\[UNIT\\]'",
    "test:integration": "bun test --test-name-pattern='^\\[INTEGRATION\\]'",
    "test:debug": "bun test --test-name-pattern='^\\[DEBUG\\]'",
    "test:all": "bun test",
    "test:coverage": "bun test --test-name-pattern='^\\[UNIT\\]' --coverage",
    "test:ci": "bun run test:unit -- --coverage && bun run test:integration -- --coverage",
    "test:db": "turbo run test",
    "depcruise": "bunx dependency-cruiser --validate .dependency-cruiser.mjs .",
    "depcruise:check": "bunx dependency-cruiser --validate .dependency-cruiser.mjs . --output-type err-long",
    "depcruise:graph": "bunx dependency-cruiser --validate .dependency-cruiser.mjs . --output-type dot --output-to dependency-graph.dot && dot -T svg dependency-graph.dot -o dependency-graph.svg"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.28.6",
    "@babel/types": "^7.29.0",
    "@commitlint/config-conventional": "^20.4.2",
    "@graphql-codegen/cli": "^6.2.1",
    "@happy-dom/global-registrator": "^20.8.9",
    "@tsconfig/bun": "^1.0.10",
    "@types/bun": "^1.3.9",
    "dependency-cruiser": "^17.3.10",
    "eslint": "^9.39.3",
    "knip": "^6.3.1",
    "prettier": "^3.8.1",
    "turbo": "^2.8.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "packageManager": "bun@1.3.6",
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "graphql": "^16.13.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "license": "AGPL-3.0",
  "dependencies": {
    "@pothos/core": "^4.12.0",
    "@pothos/plugin-scope-auth": "^4.1.6",
    "@types/pg": "^8.20.0",
    "awilix": "^13.0.3",
    "awilix-modular": "^2.1.3",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.14.0",
    "graphql": "^16.13.2",
    "graphql-yoga": "^5.21.0",
    "hono": "^4.12.12",
    "pg": "^8.20.0"
  }
}
