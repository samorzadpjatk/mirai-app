    "next-themes": "^0.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "superjson": "^2.2.1",
    "web-push": "^3.6.7",
    "workbox-webpack-plugin": "^7.3.0",
    "zod": "^4.1.4"
