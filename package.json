{
  "name": "@integral-2025-app/monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter='./packages/*'",
    "dev": "turbo run dev",
    "dev:backend": "turbo run dev --filter=@integral-2025-app/backend-server",
    "dev:notification-sender": "turbo run dev --filter=@integral-2025-app/notification-sender",
    "dev:native": "turbo run dev --filter=@integral-2025-app/native",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format:check": "turbo run format:check",
    "format:write": "turbo run format:write",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.28.6",
    "@babel/types": "^7.29.0",
    "@commitlint/config-conventional": "^20.4.2",
    "@tsconfig/bun": "^1.0.10",
    "@types/bun": "^1.3.9",
    "eslint": "^9.39.3",
    "prettier": "^3.8.1",
    "turbo": "^2.8.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "packageManager": "bun@1.3.6",
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "@tanstack/react-query": "^5.90.19",
    "@tanstack/query-core": "^5.90.20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@trpc/client": "^11.10.0"
  }
}