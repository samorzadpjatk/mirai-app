{
  "name": "@mirai-app/monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nx run-many -t build",
    "build:packages": "nx run-many -t build --projects='packages/*'",
    "dev": "nx run-many -t dev",
    "dev:backend": "nx run @mirai-app/backend-server:dev",
    "dev:notification-sender": "nx run @mirai-app/notification-sender:dev",
    "dev:native": "nx run @mirai-app/native:dev",
    "seed:dev": "nx run @mirai-app/seed:db:seed:dev",
    "seed:prod": "nx run @mirai-app/seed:db:seed:prod",
    "reset:dev": "nx run @mirai-app/seed:db:reset:dev",
    "reset:prod": "nx run @mirai-app/seed:db:reset:prod",
    "fresh:dev": "nx run @mirai-app/seed:db:fresh:dev",
    "fresh:prod": "nx run @mirai-app/seed:db:fresh:prod",
    "lint": "nx run-many -t lint --exclude=@mirai-app/monorepo",
    "lint:boundaries": "eslint . --rule '@nx/enforce-module-boundaries: error'",
    "typecheck": "nx run-many -t typecheck --exclude=@mirai-app/monorepo",
    "format:check": "prettier --check '**/*.{ts,tsx,js,jsx}'",
    "format:write": "prettier --write '**/*.{ts,tsx,js,jsx}'",
    "test": "nx run-many -t test --exclude=@mirai-app/monorepo",
    "test:watch": "nx run-many -t test:watch --exclude=@mirai-app/monorepo",
    "test:coverage": "nx run-many -t test:coverage --exclude=@mirai-app/monorepo",
    "clean": "nx run-many -t clean --exclude=@mirai-app/monorepo && rm -rf node_modules",
    "postinstall": "cd packages/db && bun run db:generate",
    "prepare": "husky",
    "setup:dev": "bun run scripts/setup-dev.ts"
  },
  "devDependencies": {
    "@babel/runtime": "^7.29.2",
    "@berenddeboer/nx-knip": "^1.1.0",
    "@commitlint/config-conventional": "^20.4.2",
    "@nx-tools/nx-container": "^7.2.3",
    "@nx/eslint": "22.7.2",
    "@nx/eslint-plugin": "^22.7.2",
    "@nx/expo": "^22.7.2",
    "@nx/jest": "22.7.2",
    "@nx/js": "22.7.2",
    "@nx/vitest": "22.7.2",
    "@tsconfig/bun": "^1.0.10",
    "@types/bun": "^1.3.13",
    "eslint": "^10.3.0",
    "husky": "^9.1.7",
    "knip": "^6.13.1",
    "lint-staged": "^17.0.4",
    "nx": "22.7.2",
    "prettier": "^3.8.0",
    "typescript-eslint": "^8.59.3"
  },
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.3.13"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "license": "AGPL-3.0",
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "overrides": {
    "esbuild": "^0.27.7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "bunx prettier --write",
      "bunx eslint --fix"
    ]
  }
}