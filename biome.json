{
  "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
  "files": {
    "maxSize": 3145728,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.expo",
      "!**/.nx",
      "!**/.nx/cache",
      "!**/coverage",
      "!**/drizzle",
      "!**/reports",
      "!**/scripts",
      "!**/__mocks__",
      "!**/vitest.setup.ts",
      "!**/jest.setup.*",
      "!**/bun.lock",
      "!**/*.json",
      "!**/ios/Pods",
      "!**/environment/volumes/email-templates",
      "!**/.codegraph",
      "!**/.agents/empty-state-handling"
    ]
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100,
    "attributePosition": "auto",
    "includes": [
      "**",
      "!**/node_modules/**",
      "!**/dist/**",
      "!**/.expo/**",
      "!**/.nx/**",
      "!**/.nx/cache/**",
      "!**/coverage/**",
      "!**/drizzle/**",
      "!**/bun.lock",
      "!**/*.json"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noForEach": "error",
        "noStaticOnlyClass": "error",
        "noUselessTernary": "error",
        "useDateNow": "error"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUnusedPrivateClassMembers": "error",
        "useExhaustiveDependencies": "error",
        "useParseIntRadix": "error"
      },
      "a11y": {
        "useSemanticElements": "error"
      },
      "performance": {
        "noReExportAll": "error"
      },
      "style": {
        "noDefaultExport": "off",
        "noImplicitBoolean": "error",
        "noNegationElse": "error",
        "noNonNullAssertion": "error",
        "useCollapsedElseIf": "error",
        "useForOf": "error",
        "useNodejsImportProtocol": "error",
        "useConsistentArrayType": { "level": "error", "options": { "syntax": "shorthand" } }
      },
      "suspicious": {
        "noArrayIndexKey": "error",
        "noDoubleEquals": "error",
        "noEmptyBlockStatements": "error",
        "noExplicitAny": "error",
        "noExtraNonNullAssertion": "error",
        "noGlobalIsNan": "error",
        "noPrototypeBuiltins": "error",
        "noRedundantUseStrict": "error",
        "noConsole": { "level": "error", "options": { "allow": ["log"] } }
      }
    },
    "includes": [
      "**",
      "!**/node_modules/**",
      "!**/dist/**",
      "!**/.expo/**",
      "!**/.nx/**",
      "!**/.nx/cache/**",
      "!**/coverage/**",
      "!**/drizzle/**",
      "!**/*.config.*",
      "!**/*.test.*",
      "!**/*.spec.*",
      "!**/jest.config.*",
      "!**/vitest.config.*"
    ]
  },
  "overrides": [
    {
      "includes": ["**/scripts/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": { "level": "off", "options": { "allow": ["log"] } }
          }
        }
      }
    },
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/packages/common/src/utils/create-client-logger.ts",
        "**/packages/common/src/utils/logger-factory.ts",
        "**/packages/common/src/test-utils/test-helpers.ts",
        "**/packages/db/src/migrate.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "quoteStyle": "double",
      "attributePosition": "auto"
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineEnding": "lf",
      "trailingCommas": "none"
    }
  },
  "css": {
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineEnding": "lf",
      "lineWidth": 100
    }
  },
  "html": {
    "parser": {
      "interpolation": true
    }
  }
}
