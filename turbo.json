{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY",
    "LOG_LEVEL"
  ],

  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },

    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".next/**", ".astro/**"]
    },

    "lint": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": true
    },

    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": true
    },

    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "cache": true
    },

    "test:watch": {
      "cache": false,
      "persistent": true
    },

    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "cache": true
    },

    "format:check": {
      "outputs": [],
      "cache": true
    },

    "format:write": {
      "outputs": [],
      "cache": true
    },

    "depcruise": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": true
    },

    "depcruise:check": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": true
    },

    "depcruise:graph": {
      "dependsOn": ["^build"],
      "outputs": ["dependency-graph.*"],
      "cache": true
    }
  }
}
