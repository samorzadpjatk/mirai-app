{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY"
  ],

  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },

    "lint": {
      "outputs": []
    },

    "typecheck": {
      "outputs": []
    },

    "test": {
      "outputs": ["coverage/**"]
    },

    "test:ci": {
      "outputs": ["coverage/**"]
    },

    "test:coverage": {
      "outputs": ["coverage/**"]
    },

    "test:unit": {
      "outputs": ["coverage/**"]
    },

    "test:integration": {
      "outputs": ["coverage/**"]
    },

    "format:check": {
      "outputs": []
    },

    "format:write": {
      "outputs": []
    },

    "depcruise": {
      "outputs": []
    },

    "depcruise:check": {
      "outputs": []
    },

    "depcruise:graph": {
      "outputs": ["dependency-graph.*"]
    }
  }
}
