{
  "compilerOptions": {
    /* Base Options */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "esnext",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "auto",
    "isolatedModules": true,

    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "checkJs": false,

    /* Bundled projects */
    "noEmit": false,
    "module": "ESNext",
    "incremental": true,
    "moduleResolution": "bundler",
  },
  "exclude": ["node_modules"]
}
