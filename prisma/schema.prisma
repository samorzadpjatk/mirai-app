// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
    // Further reading:
    // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
    // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
    url      = env("DATABASE_URL")
}

// Necessary for Next auth
model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String? // @db.Text
    access_token             String? // @db.Text
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String? // @db.Text
    session_state            String?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id                         String                 @id @default(cuid())
    name                       String?
    email                      String?                @unique
    emailVerified              DateTime?
    image                      String?
    wristNumber                String?                @unique
    houseNumber                String?                @unique
    accounts                   Account[]
    sessions                   Session[]
    groups                     UserGroup[]
    isAdmin                    Boolean                @default(false)
    isModerator                Boolean               @default(false)
    organizerGroups            Group[]                @relation("UserOrganizerGroups")
    coinTransactionsAdmin      CoinTransaction[]      @relation("UserCoinTransactionsAdmin")
    pushSubscriptions          PushSubscription[]
    notificationSchedules      NotificationSchedule[] @relation("NotificationScheduleAdmin")
    webPushNotificationsAdmin  WebPushNotification[]  @relation("WebPushNotificationAdmin")
    webPushNotificationsTarget WebPushNotification[]  @relation("WebPushNotificationTargetUser")
}

model Group {
    id                    String                 @id @default(uuid())
    name                  String
    organizerId           String
    organizer             User                   @relation("UserOrganizerGroups", fields: [organizerId], references: [id])
    code                  String                 @unique
    members               UserGroup[]
    coins                 Int                    @default(0)
    coinTransactions      CoinTransaction[]
    webPushNotifications  WebPushNotification[]  @relation("WebPushNotificationTargetGroup")
}

model UserGroup {
    id      String @id @default(uuid())
    userId  String
    groupId String
    user    User   @relation(fields: [userId], references: [id])
    group   Group  @relation(fields: [groupId], references: [id])
}

model CoinTransaction {
    id        String   @id @default(uuid())
    groupId   String
    group     Group    @relation(fields: [groupId], references: [id])
    amount    Int
    reason    String?  // Optional reason for the transaction
    createdAt DateTime @default(now())
    adminId   String
    admin     User     @relation("UserCoinTransactionsAdmin", fields: [adminId], references: [id])
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

model PushSubscription {
    id        String   @id @default(cuid())
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    endpoint  String
    p256dh    String
    auth      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId])
}

model NotificationSchedule {
    id          String   @id @default(cuid())
    name        String   // e.g., "Daily Ranking Update", "Weekly Summary"
    description String?  // Optional description
    startDate   DateTime // When the schedule starts
    endDate     DateTime // When the schedule ends
    hour        Int      // Hour of the day (0-23)
    minute      Int      @default(0) // Minute of the hour (0-59)
    isActive    Boolean  @default(true)
    lastRun     DateTime? // When was this schedule last executed
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    createdBy   String   // Admin who created this schedule
    admin       User     @relation("NotificationScheduleAdmin", fields: [createdBy], references: [id])
}

model WebPushNotification {
    id               String   @id @default(cuid())
    title            String   // Notification title
    body             String   // Notification body/message
    icon             String?  // Optional notification icon URL
    badge            String?  // Optional badge icon URL
    tag              String?  // Optional tag for grouping notifications
    requireInteraction Boolean @default(false) // Whether notification requires user interaction
    silent           Boolean  @default(false) // Whether notification should be silent
    targetUserId     String?  // If sent to specific user
    targetUser       User?    @relation("WebPushNotificationTargetUser", fields: [targetUserId], references: [id])
    targetGroupId    String?  // If sent to specific group
    targetGroup      Group?   @relation("WebPushNotificationTargetGroup", fields: [targetGroupId], references: [id])
    sentToAll        Boolean  @default(false) // If sent to all users
    status           String   @default("pending") // pending, sent, failed
    sentAt           DateTime? // When the notification was actually sent
    failureReason    String?  // Reason for failure if status is 'failed'
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt
    createdBy        String   // Admin who created this notification
    admin            User     @relation("WebPushNotificationAdmin", fields: [createdBy], references: [id])
    
    // Delivery tracking
    deliveryAttempts Int      @default(0)
    lastAttemptAt    DateTime?
}
