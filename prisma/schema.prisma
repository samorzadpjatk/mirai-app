// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  url      = env("DATABASE_URL")
}

// Necessary for Next auth
model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? // @db.Text
  access_token             String? // @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? // @db.Text
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh_token_expires_in Int?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                        String                 @id @default(cuid())
  name                      String?
  email                     String?                @unique
  emailVerified             DateTime?
  image                     String?
  wristNumber               String?                @unique
  houseNumber               String?                
  accounts                  Account[]
  sessions                  Session[]
  group                     Group?                 @relation(fields: [groupId], references: [id])
  groupId                   String?                 
  isAdmin                   Boolean                @default(false)
  isModerator               Boolean                @default(false)
  isServiceAccount          Boolean                @default(false)
  organizerGroup            Group[]                 @relation("UserOrganizerGroups")
  coinTransactionsAdmin     CoinTransaction[]      @relation("UserCoinTransactionsAdmin")
  pushSubscriptions         PushSubscription[]
  notificationSchedules     NotificationSchedule[] @relation("NotificationScheduleAdmin")
  receivedPushNotifications NotificationPush[]
  sentPushNotifications     Notification[]         @relation("WebPushNotificationAdmin")
}

model Group {
  id               String            @id @default(uuid())
  name             String
  organizerId      String            
  organizer        User              @relation("UserOrganizerGroups", fields: [organizerId], references: [id])
  code             String            @unique
  members          User[]
  coins            Int               @default(0)
  coinTransactions CoinTransaction[]
}

model CoinTransaction {
  id        String   @id @default(uuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id])
  amount    Int
  reason    String? // Optional reason for the transaction
  createdAt DateTime @default(now())
  adminId   String
  admin     User     @relation("UserCoinTransactionsAdmin", fields: [adminId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId])
}

model NotificationSchedule {
  id               String        @id @default(cuid())
  name             String
  notificationType String // e.g., "daily-ranking"      
  notificationId   String?
  notification     Notification? @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  startDate        DateTime // When the schedule starts
  endDate          DateTime // When the schedule ends
  hour             Int // Hour of the day (0-23)
  minute           Int           @default(0) // Minute of the hour (0-59)
  isActive         Boolean       @default(true)
  lastRun          DateTime? // When was this schedule last executed
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  createdById      String // Admin who created this schedule
  createdBy        User          @relation("NotificationScheduleAdmin", fields: [createdById], references: [id])
}

model Notification {
  id          String                 @id @default(cuid())
  title       String // Notification title
  body        String // Notification body/message
  url         String // Optional URL to open when the notification is clicked
  pushes      NotificationPush[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  createdById String // Admin who created this notification
  createdBy   User                   @relation("WebPushNotificationAdmin", fields: [createdById], references: [id])
  schedules   NotificationSchedule[]
}

model NotificationPush {
  targetUserId   String
  targetUser     User         @relation(fields: [targetUserId], references: [id], onDelete: Cascade)
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  status         String // sent or failed
  sentAt         DateTime? // When the notification was actually sent
  failureReason  String? // Reason for failure if status is 'failed'

  @@id([targetUserId, notificationId])
}
