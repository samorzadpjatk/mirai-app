{
  "name": "@mirai-app/use-cases",
  "version": "0.1.0",
  "description": "Use cases layer - application orchestration, depends only on domain",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ports/*.ts": "./src/*/ports/*.ts",
    "./ports/*/gateway.ts": "./src/*/ports/gateway.ts",
    "./ports/challenge/*.ts": "./src/challenge/ports/*.ts",
    "./ports/challenge/submission/*.ts": "./src/challenge/ports/submission/*.ts",
    "./ports/challenge/vote/*.ts": "./src/challenge/ports/vote/*.ts",
    "./ports/notification/*.ts": "./src/notification/ports/*.ts",
    "./ports/notification/delivery/*.ts": "./src/notification/ports/delivery/*.ts",
    "./ports/notification/schedule/*.ts": "./src/notification/ports/schedule/*.ts",
    "./ports/notification/sender/*.ts": "./src/notification/ports/sender/*.ts",
    "./ports/ranking/*.ts": "./src/ranking/ports/*.ts",
    "./interactors": "./src/interactors/index.ts",
    "./interactors/*": "./src/interactors/*.ts",
    "./dto/*": "./src/dto/*.ts",
    "./errors/*": "./src/errors/*.ts",
    "./modules/*": "./src/modules/*.ts",
    "./test": "./src/test/index.ts",
    "./test/*": "./src/test/*.ts",
    "./system/*": "./src/system/*.ts"
  },
  "scripts": {
    "test": "bun test",
    "test:unit": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format:check": "prettier --check src/",
    "format:write": "prettier --write src/"
  },
  "dependencies": {
    "@mirai-app/domain": "workspace:*",
    "effect": "^3.14.0"
  },
  "devDependencies": {
    "@mirai-app/adapters": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "// note": "Only depends on @mirai-app/domain - innermost layer"
}
