{
  "name": "@mirai-app/use-cases",
  "version": "0.1.0",
  "description": "Use cases layer - application orchestration, depends only on domain",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./activity-feed": "./src/activity-feed/index.ts",
    "./activity-feed/ports": "./src/activity-feed/ports/index.ts",
    "./challenge": "./src/challenge/index.ts",
    "./challenge/ports/*": "./src/challenge/ports/*.ts",
    "./challenge-submission": "./src/challenge-submission/index.ts",
    "./challenge-submission/ports/*": "./src/challenge-submission/ports/*.ts",
    "./challenge-vote": "./src/challenge-vote/index.ts",
    "./challenge-vote/ports/*": "./src/challenge-vote/ports/*.ts",
    "./coin": "./src/coin/index.ts",
    "./coin/ports/*": "./src/coin/ports/*.ts",
    "./group": "./src/group/index.ts",
    "./group/ports/*": "./src/group/ports/*.ts",
    "./location": "./src/location/index.ts",
    "./location/ports": "./src/location/ports/index.ts",
    "./notification": "./src/notification/index.ts",
    "./notification/ports/*": "./src/notification/ports/*.ts",
    "./reward": "./src/reward/index.ts",
    "./reward/ports": "./src/reward/ports/index.ts",
    "./shared/ports": "./src/shared/ports/index.ts",
    "./sponsor": "./src/sponsor/index.ts",
    "./sponsor/ports": "./src/sponsor/ports/index.ts",
    "./storage": "./src/storage/index.ts",
    "./storage/ports": "./src/storage/ports/index.ts",
    "./submission-report": "./src/submission-report/index.ts",
    "./submission-report/ports/*": "./src/submission-report/ports/*.ts",
    "./trip": "./src/trip/index.ts",
    "./trip/ports/*": "./src/trip/ports/*.ts",
    "./user": "./src/user/index.ts",
    "./user/ports/*": "./src/user/ports/*.ts"
  },
  "scripts": {
    "test": "bun test",
    "test:unit": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format:check": "prettier --check src/",
    "format:write": "prettier --write src/"
  },
  "dependencies": {
    "@mirai-app/domain": "workspace:*",
    "effect": "^3.14.0"
  },
  "devDependencies": {
    "@mirai-app/adapters": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "// note": "Only depends on @mirai-app/domain - innermost layer"
}
