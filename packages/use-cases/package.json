{
  "name": "@mirai-app/use-cases",
  "version": "0.1.0",
  "description": "Use cases layer - application orchestration, depends only on domain",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ports/*": {
      "types": "./dist/ports/*.d.ts",
      "default": "./dist/ports/*.js"
    },
    "./interactors/*": {
      "types": "./dist/interactors/*.d.ts",
      "default": "./dist/interactors/*.js"
    },
    "./dto/*": {
      "types": "./dist/dto/*.d.ts",
      "default": "./dist/dto/*.js"
    },
    "./errors/*": {
      "types": "./dist/errors/*.d.ts",
      "default": "./dist/errors/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "bun test",
    "test:unit": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format:check": "prettier --check src/",
    "format:write": "prettier --write src/"
  },
  "dependencies": {
    "@mirai-app/domain": "workspace:*",
    "@mirai-app/frameworks": "workspace:*",
    "effect": "^3.18.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "// note": "Only depends on @mirai-app/domain - innermost layer"
}
