{
  "name": "@mirai-app/shared",
  "version": "0.1.0",
  "description": "Shared utilities across all layers",
  "private": true,
  "license": "AGPL-3.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./design-tokens": "./src/design-tokens/index.ts",
    "./design-tokens/*": "./src/design-tokens/*.ts"
  },
  "scripts": {
    "test": "bun test",
    "test:unit": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format:check": "prettier --check src/",
    "format:write": "prettier --write src/"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "typescript": "^5",
    "react": "^19.0.0"
  }
}
