{
  "name": "@mirai-app/frameworks",
  "version": "0.1.0",
  "description": "Frameworks layer - technical configuration, outermost layer",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./drizzle": "./src/drizzle/index.ts",
    "./drizzle/*": "./src/drizzle/*.ts",
    "./drizzle/schema": "./src/drizzle/schema/index.ts",
    "./drizzle/schema/*": "./src/drizzle/schema/*.ts",
    "./graphql": "./src/graphql/index.ts",
    "./graphql/*": "./src/graphql/*.ts",
    "./graphql/client": "./src/graphql/client.tsx",
    "./supabase/*": "./src/supabase/*.ts",
    "./supabase/react": "./src/supabase/react.tsx",
    "./auth": "./src/auth/index.ts",
    "./auth/client": "./src/auth/client.ts",
    "./auth/server": "./src/auth/server.ts",
    "./auth/store": "./src/auth/store/index.ts",
    "./auth/hooks": "./src/auth/hooks/index.ts",
    "./stores": "./src/stores/index.ts",
    "./storage": "./src/storage/index.ts",
    "./supabase": "./src/supabase/index.ts",
    "./di": "./src/di/index.ts",
    "./layers": "./src/layers/index.ts"
  },
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format:check": "prettier --check src/",
    "format:write": "prettier --write src/"
  },
  "dependencies": {
    "@mirai-app/domain": "workspace:*",
    "@mirai-app/use-cases": "workspace:*",
    "@mirai-app/adapters": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.14.0",
    "pg": "^8.20.0",
    "@supabase/supabase-js": "^2.89.0",
    "hono": "^4.12.12",
    "graphql": "^16.13.2",
    "graphql-yoga": "^5.21.0",
    "@pothos/core": "^4.12.0",
    "@pothos/plugin-scope-auth": "^4.1.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "~19.1.17",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^19.1.0"
  },
  "// note": "Outermost layer - contains framework-specific configuration only"
}
