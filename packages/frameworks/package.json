{
  "name": "@mirai-app/frameworks",
  "version": "0.1.0",
  "description": "Frameworks layer - technical configuration, outermost layer",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./drizzle": "./src/drizzle/index.ts",
    "./drizzle/*": "./src/drizzle/*.ts",
    "./drizzle/schema": "./src/drizzle/schema/index.ts",
    "./drizzle/schema/*": "./src/drizzle/schema/*.ts",
    "./supabase/*": "./src/supabase/*.ts",
    "./supabase/react": "./src/supabase/react.tsx",
    "./auth": "./src/auth/index.ts",
    "./auth/client": "./src/auth/client.ts",
    "./auth/server": "./src/auth/server.ts",
    "./auth/store": "./src/auth/store/index.ts",
    "./auth/hooks": "./src/auth/hooks/index.ts",
    "./stores": "./src/stores/index.ts",
    "./supabase": "./src/supabase/index.ts",
    "./di": "./src/di/index.ts",
    "./graphql": "./src/graphql/index.ts",
    "./location": "./src/location/index.ts"
  },
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format:check": "prettier --check src/",
    "format:write": "prettier --write src/",
    "sync:schema": "bun run src/graphql/generate-schema.ts && graphql-codegen --config src/graphql/codegen.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:migrate:dev": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:migrate:prod": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:push:dev": "drizzle-kit push --config=drizzle.config.ts",
    "db:push:prod": "drizzle-kit push --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "db:studio:dev": "drizzle-kit studio --config=drizzle.config.ts",
    "db:studio:prod": "drizzle-kit studio --config=drizzle.config.ts",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "db:drop": "drizzle-kit drop --config=drizzle.config.ts"
  },
  "dependencies": {
    "@mirai-app/domain": "workspace:*",
    "@mirai-app/use-cases": "workspace:*",
    "@mirai-app/adapters": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.14.0",
    "@supabase/supabase-js": "^2.89.0",
    "hono": "^4.12.12",
    "graphql": "^16.13.2",
    "graphql-scalars": "^1.25.0",
    "graphql-tag": "^2.12.6",
    "graphql-yoga": "^5.21.0",
    "@pothos/core": "^4.12.0",
    "@pothos/plugin-relay": "^4.7.0",
    "@pothos/plugin-dataloader": "^4.4.3",
    "@pothos/plugin-scope-auth": "^4.1.6",
    "dataloader": "^2.1.0",
    "zustand": "^5.0.11",
    "urql": "^4.2.2",
    "@urql/core": "^5.0.0",
    "wonka": "^6.3.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "~19.1.17",
    "drizzle-kit": "^0.31.0",
    "@graphql-codegen/cli": "^5.0.0",
    "@graphql-codegen/typescript": "^4.0.1",
    "@graphql-codegen/typescript-operations": "^4.0.1",
    "@graphql-codegen/typescript-urql": "^4.0.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^19.1.0"
  }
}
