{
  "name": "@repo/frameworks",
  "version": "0.1.0",
  "description": "Frameworks layer - technical configuration, outermost layer",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./trpc/*": {
      "types": "./dist/trpc/*.d.ts",
      "default": "./dist/trpc/*.js"
    },
    "./trpc/client": {
      "types": "./dist/trpc/client/index.d.ts",
      "default": "./src/trpc/client/index.ts"
    },
    "./trpc/client/query": {
      "types": "./dist/trpc/client/query/index.d.ts",
      "default": "./src/trpc/client/query/index.ts"
    },
    "./trpc/hooks": {
      "types": "./dist/trpc/hooks/index.d.ts",
      "default": "./src/trpc/hooks/index.ts"
    },
    "./prisma/*": {
      "types": "./dist/prisma/*.d.ts",
      "default": "./dist/prisma/*.js"
    },
    "./supabase/*": {
      "types": "./dist/supabase/*.d.ts",
      "default": "./dist/supabase/*.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./src/auth/index.ts"
    },
    "./auth/client": {
      "types": "./dist/auth/client.d.ts",
      "default": "./src/auth/client.ts"
    },
    "./auth/server": {
      "types": "./dist/auth/server.d.ts",
      "default": "./src/auth/server.ts"
    },
    "./auth/store": {
      "types": "./dist/auth/store/index.d.ts",
      "default": "./src/auth/store/index.ts"
    },
    "./auth/hooks": {
      "types": "./dist/auth/hooks/index.d.ts",
      "default": "./src/auth/hooks/index.ts"
    },
    "./stores": {
      "types": "./dist/stores/index.d.ts",
      "default": "./src/stores/index.ts"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "default": "./src/storage/index.ts"
    },
    "./prisma": {
      "types": "./dist/prisma/index.d.ts",
      "default": "./src/prisma/index.ts"
    },
    "./supabase": {
      "types": "./dist/supabase/index.d.ts",
      "default": "./src/supabase/index.ts"
    },
    "./di": {
      "types": "./dist/di/index.d.ts",
      "default": "./src/di/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format:check": "prettier --check src/",
    "format:write": "prettier --write src/"
  },
  "dependencies": {
    "@repo/domain": "workspace:*",
    "@repo/use-cases": "workspace:*",
    "@trpc/server": "^11.10.0",
    "@trpc/client": "^11.10.0",
    "@trpc/tanstack-react-query": "^11.10.0",
    "@prisma/client": "^7.3.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@supabase/supabase-js": "^2.89.0",
    "superjson": "^2.2.6",
    "zod": "^4.3.4",
    "@tanstack/react-query": "^5.90.19",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "~19.1.17",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^19.1.0"
  },
  "// note": "Outermost layer - contains framework-specific configuration only"
}
