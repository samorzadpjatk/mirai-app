{
  "name": "@integral-2025-app/trpc",
  "version": "1.0.0",
  "description": "Shared tRPC routers and utilities for Integral 2025 App",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./client/expo": {
      "types": "./dist/client/expo.d.ts",
      "import": "./dist/client/expo.js",
      "default": "./dist/client/expo.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@integral-2025-app/auth": "workspace:*",
    "@integral-2025-app/common-utils": "workspace:*",
    "@integral-2025-app/db": "workspace:*",
    "@integral-2025-app/supabase": "workspace:*",
    "@tanstack/react-query": "^5.90.16",
    "@trpc/client": "^11.8.1",
    "@trpc/server": "^11.8.1",
    "@trpc/tanstack-react-query": "^11.8.1",
    "expo-server-sdk": "^3.15.0",
    "superjson": "^2.2.6",
    "zod": "^4.3.4"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@t3-oss/env-core": "^0.13.10",
    "@types/node": "^24.10.4",
    "@types/react": "~19.1.17",
    "@types/react-dom": "~19.1.11",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "postcss": "^8.5.6",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
