{
  "name": "@mirai-app/trpc",
  "version": "1.0.0",
  "description": "Shared tRPC routers and utilities for Integral 2025 App",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./client/query": {
      "types": "./dist/client/query/index.d.ts",
      "import": "./src/client/query/index.ts",
      "default": "./src/client/query/index.ts"
    },
    "./client/expo": {
      "types": "./dist/client/expo.d.ts",
      "import": "./dist/client/expo.js",
      "default": "./dist/client/expo.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "clean": "rm -rf node_modules"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@mirai-app/auth": "workspace:*",
    "@mirai-app/db": "workspace:*",
    "@mirai-app/shared": "workspace:*",
    "@mirai-app/supabase": "workspace:*",
    "@tanstack/react-query": "^5.90.19",
    "@trpc/client": "^11.10.0",
    "@trpc/server": "^11.10.0",
    "@trpc/tanstack-react-query": "^11.10.0",
    "expo-server-sdk": "^3.15.0",
    "superjson": "^2.2.6",
    "zustand": "^5.0.11",
    "zod": "^4.3.4"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.17",
    "@types/react-dom": "~19.1.11",
    "postcss": "^8.5.6",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3"
  }
}
