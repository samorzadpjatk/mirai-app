{
  "name": "@integral-2025-app/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./src/client.ts",
      "default": "./src/client.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check": "eslint . && tsc --noEmit",
    "clean": "rm -rf node_modules",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint --fix ."
  },
  "dependencies": {
    "@integral-2025-app/db": "workspace:*",
    "@integral-2025-app/supabase": "workspace:*",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@types/react": "~19.1.17",
    "eslint": "^9.39.2",
    "jsdom": "^25.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0"
  },
  "peerDependencies": {
    "react": "^19.1.0"
  }
}
