{
  "name": "@integral-2025-app/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check": "eslint . && tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint --fix .",
    "test": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@integral-2025-app/common-types": "workspace:*",
    "@integral-2025-app/db": "workspace:*",
    "@integral-2025-app/supabase": "workspace:*",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@integral-2025-app/vitest-config": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^24.10.4",
    "@types/react": "~19.1.17",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "eslint": "^9.39.2",
    "jsdom": "^25.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "react": "^19.1.0"
  }
}
