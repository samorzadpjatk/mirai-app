{
  "name": "@mirai-app/auth",
  "version": "0.1.0",
  "nx": { "tags": ["type:package", "scope:auth"] },
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./src/client.ts",
      "default": "./src/client.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check": "eslint . && tsc --noEmit",
    "clean": "rm -rf node_modules",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mirai-app/db": "workspace:*",
    "@mirai-app/shared": "workspace:*",
    "@mirai-app/supabase": "workspace:*",
    "jotai": "^2.18.0",
    "jotai-zustand": "^0.6.0",
    "zod": "^4.3.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "~19.1.17",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.39.2",
    "jsdom": "^25.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  }
}
