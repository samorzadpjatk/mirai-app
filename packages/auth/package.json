{
  "name": "@integral-2025-app/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.d.ts",
      "import": "./src/client.js"
    },
    "./server": {
      "types": "./src/server.d.ts",
      "import": "./src/server.js"
    },
    "./hooks": {
      "types": "./src/hooks.d.ts",
      "import": "./src/hooks.js"
    },
    "./context": {
      "types": "./src/context.d.ts",
      "import": "./src/context.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "eslint . && tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@integral-2025-app/common-types": "workspace:*",
    "@supabase/supabase-js": "^2.80.0",
    "zod": "^4.1.4"
  },
  "devDependencies": {
    "react": "^19.1.1",
    "@integral-2025-app/vitest-config": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.19.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0",
    "vitest": "^4.0.15",
    "@vitest/coverage-v8": "^4.0.15",
    "jsdom": "^27.2.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
