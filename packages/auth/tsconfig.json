{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "~/*": ["./src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vitest"],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "emitDeclarationOnly": true,
    "composite": true,
    "noEmit": false
  },
  "references": [
    { "path": "../db" },
    { "path": "../common" },
    { "path": "../supabase" }
  ],
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "**/drizzle/**",
    "drizzle/**",
    "**/__tests__/**",
    "**/*.test.*"
  ]
}
