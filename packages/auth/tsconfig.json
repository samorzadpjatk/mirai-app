{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "types": ["node", "vitest", "@testing-library/jest-dom"],
    "paths": {
      "~/*": ["./src/*"],
      "@integral-2025-app/common-types": ["../common-types/src/index.ts"],
      "@integral-2025-app/supabase": ["../supabase/src/index.ts"]
    }
  },
  "include": ["src/**/*","vitest.setup.ts","vitest.config.ts"],
  "exclude": ["node_modules", "dist"],
  "references": [
    {
      "path": "../common-types"
    }
  ]
}
