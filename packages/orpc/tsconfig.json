{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"]
    },
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["DOM", "ES2022"],
    "types": ["vitest", "node"],
    "declaration": true,
    "emitDeclarationOnly": true,
    "composite": true,
    "noEmit": false
  },
  "references": [
    { "path": "../db" },
    { "path": "../shared" },
    { "path": "../supabase" },
    { "path": "../auth" }
  ],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "vitest.config.ts", "vitest.setup.ts", "src/**/__tests__/**/*"]
}
