{
  "name": "@mirai-app/orpc",
  "version": "1.0.0",
  "description": "Shared oRPC routers and utilities for MIRAI App",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./client/query": {
      "types": "./dist/client/query/index.d.ts",
      "import": "./src/client/query/index.ts",
      "default": "./src/client/query/index.ts"
    },
    "./utils/activityFeed": {
      "types": "./dist/utils/activityFeed.d.ts",
      "import": "./src/utils/activityFeed.ts",
      "default": "./src/utils/activityFeed.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bunx --bun vitest --run --changed",
    "test:ci": "bunx --bun vitest run --coverage",
    "test:watch": "vitest",
    "clean": "rm -rf node_modules"
  },
  "keywords": [],
  "nx": {
    "tags": ["type:package", "scope:api"]
  },
  "private": true,
  "license": "AGPL-3.0",
  "dependencies": {
    "@mirai-app/auth": "workspace:*",
    "@mirai-app/db": "workspace:*",
    "@mirai-app/shared": "workspace:*",
    "@mirai-app/supabase": "workspace:*",
    "@tanstack/react-query": "^5.90.19",
    "@orpc/client": "^1.14.2",
    "@orpc/server": "^1.14.2",
    "@orpc/tanstack-query": "^1.14.2",
    "expo-server-sdk": "^3.15.0",
    "pino": "^9.6.0",
    "zod": "^4.3.4"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.2.0",
    "@vitest/coverage-istanbul": "^4.1.8",
    "jsdom": "^29.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
