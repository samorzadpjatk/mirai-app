{
  "name": "@mirai-app/orpc",
  "version": "1.0.0",
  "description": "Shared oRPC routers and utilities for MIRAI App",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./client/query": {
      "types": "./dist/client/query/index.d.ts",
      "import": "./src/client/query/index.ts",
      "default": "./src/client/query/index.ts"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./src/server.ts",
      "default": "./src/server.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "clean": "rm -rf node_modules"
  },
  "keywords": [],
  "private": true,
  "license": "AGPL-3.0",
  "dependencies": {
    "@mirai-app/auth": "workspace:*",
    "@mirai-app/db": "workspace:*",
    "@mirai-app/shared": "workspace:*",
    "@mirai-app/supabase": "workspace:*",
    "@tanstack/react-query": "^5.90.19",
    "@orpc/client": "^1.14.2",
    "@orpc/server": "^1.14.2",
    "@orpc/tanstack-query": "^1.14.2",
    "expo-server-sdk": "^3.15.0",
    "zustand": "^5.0.11",
    "zod": "^4.3.4"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "~19.1.17",
    "@types/react-dom": "~19.1.11",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
