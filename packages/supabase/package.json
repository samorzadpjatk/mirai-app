{
  "name": "@mirai-app/supabase",
  "version": "1.0.0",
  "description": "",
  "nx": { "tags": ["type:package", "scope:shared"] },
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "import": "./src/react.tsx",
      "types": "./dist/react.d.ts",
      "default": "./src/react.tsx"
    },
    "./types": {
      "import": "./src/types.ts",
      "types": "./dist/types.d.ts",
      "default": "./src/types.ts"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf node_modules"
  },
  "keywords": [],
  "license": "AGPL-3.0",
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "~19.2.10",
    "@vitest/coverage-v8": "^3.2.4",
    "react": "^19.2.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.89.0"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  }
}