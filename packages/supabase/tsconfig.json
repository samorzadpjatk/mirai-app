{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"]
    },
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "moduleResolution": "bundler"
    /* composite+declaration needed because this package is referenced by others */
  },
  "include": ["src/**/*", "vitest.config.ts", "vitest.setup.ts"],
}
