{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "paths": {
      "~/*": ["./src/*"]
    },
    "outDir": "dist",
    "rootDir": "src",
    "types": ["@testing-library/jest-dom", "@testing-library/react"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "vitest.config.ts", "vitest.setup.ts", "**/__tests__/**/*", "**/*.test.ts", "**/*.test.tsx"]
}
