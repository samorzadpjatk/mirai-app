{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "jsx": "react-jsx",
    "paths": {
      "~/*": ["./src/*"]
    },
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "emitDeclarationOnly": true,
    "composite": true,
    "noEmit": false,
    "types": ["@testing-library/jest-dom", "@testing-library/react", "vitest", "bun"]
  },
  "references": [],
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "vitest.config.ts", "vitest.setup.ts"]
}
