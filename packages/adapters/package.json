{
  "name": "@mirai-app/adapters",
  "version": "0.1.0",
  "description": "Adapters layer - interface adapters, depends on domain and use-cases",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./service-layer": "./src/system/service-layer.ts"
  },
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:unit": "bun test -t '\\[UNIT\\]'",
    "test:integration": "bun test -t '\\[INTEGRATION\\]'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format:check": "prettier --check src/",
    "format:write": "prettier --write src/"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1030.0",
    "@aws-sdk/s3-request-presigner": "3.1030.0",
    "@mirai-app/domain": "workspace:*",
    "@mirai-app/use-cases": "workspace:*",
    "@mirai-app/frameworks": "workspace:*",
    "effect": "^3.14.0",
    "expo-server-sdk": "^3.14.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "// note": "Depends on domain and use-cases - implements their interfaces"
}
