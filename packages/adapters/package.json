{
  "name": "@mirai-app/adapters",
  "version": "0.1.0",
  "description": "Adapters layer - interface adapters, depends on domain and use-cases",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./service-layer": "./src/system/service-layer.ts",
    "./storage": "./src/storage/index.ts",
    "./infrastructure": "./src/infrastructure/index.ts",
    "./infrastructure/drizzle": "./src/infrastructure/drizzle/index.ts",
    "./infrastructure/supabase": "./src/infrastructure/supabase/index.ts",
    "./infrastructure/effect": "./src/infrastructure/effect/index.ts"
  },
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:unit": "bun test -t '\\[UNIT\\]'",
    "test:integration": "bun test -t '\\[INTEGRATION\\]'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format:check": "prettier --check src/",
    "format:write": "prettier --write src/"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1030.0",
    "@aws-sdk/s3-request-presigner": "3.1030.0",
    "@mirai-app/domain": "workspace:*",
    "@mirai-app/use-cases": "workspace:*",
    "@supabase/supabase-js": "^2.89.0",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.14.0",
    "expo-server-sdk": "^3.14.0",
    "ioredis": "^5.6.1",
    "nodemailer": "^8.0.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/ioredis": "^5.0.0",
    "@types/nodemailer": "^8.0.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.9.3"
  },
  "// note": "Depends on domain and use-cases - implements their interfaces. Infrastructure (Drizzle, Supabase types) is now co-located here."
}
