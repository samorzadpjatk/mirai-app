{
  "name": "@mirai-app/adapters",
  "version": "0.1.0",
  "description": "Adapters layer - interface adapters, depends on domain and use-cases",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./controllers/*": "./src/controllers/*.ts",
    "./auth": "./src/controllers/auth/index.ts",
    "./auth/authServer": "./src/controllers/auth/authServer.ts",
    "./gateways": "./src/gateways/index.ts",
    "./gateways/*": "./src/gateways/*.ts",
    "./mappers/*": "./src/mappers/*.ts",
    "./api/*": "./src/api/*.ts",
    "./api": "./src/api/index.ts",
    "./services/*": "./src/services/*.ts",
    "./utils/*": "./src/utils/*.ts",
    "./modules": "./src/modules/RepositoryModule.ts",
    "./modules/*": "./src/modules/*.ts",
    "./errors": "./src/errors/index.ts",
    "./layers": "./src/layers/index.ts",
    "./test-utils": "./src/test-utils/index.ts"
  },
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:unit": "bun test -t '\\[UNIT\\]'",
    "test:integration": "bun test -t '\\[INTEGRATION\\]'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format:check": "prettier --check src/",
    "format:write": "prettier --write src/"
  },
  "dependencies": {
    "@mirai-app/domain": "workspace:*",
    "@mirai-app/use-cases": "workspace:*",
    "@mirai-app/shared": "workspace:*",
    "@trpc/server": "^11.10.0",
    "effect": "^3.18.4",
    "expo-server-sdk": "^3.14.0",
    "superjson": "^2.2.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "// note": "Depends on domain and use-cases - implements their interfaces"
}
