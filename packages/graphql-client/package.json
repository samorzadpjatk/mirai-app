{
  "name": "@mirai-app/graphql-client",
  "version": "0.1.0",
  "description": "GraphQL client types and hooks for Mirai App",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/generated/types.ts",
    "./operations": "./src/generated/operations.ts",
    "./urql": "./src/generated/urql.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format:check": "prettier --check src/",
    "format:write": "prettier --write src/"
  },
  "dependencies": {
    "@urql/core": "^5.0.0",
    "urql": "^4.2.2",
    "graphql": "^16.13.2"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.2.1",
    "@graphql-codegen/introspection": "^4.0.0",
    "@graphql-codegen/schema-ast": "^4.1.0",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.0",
    "@graphql-codegen/typescript-urql": "^4.0.0",
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^19.1.0"
  }
}
