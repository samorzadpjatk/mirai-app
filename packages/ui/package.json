{
  "name": "@mirai-app/ui",
  "version": "0.1.0",
  "description": "Shared Tamagui UI component library for web and native",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/types/src/index.d.ts",
        "default": "./dist/jsx/index.jsx"
      },
      "import": {
        "types": "./dist/types/src/index.d.ts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/types/src/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./components": {
      "react-native": {
        "types": "./dist/types/src/components/index.d.ts",
        "default": "./dist/jsx/components/index.jsx"
      },
      "import": {
        "types": "./dist/types/src/components/index.d.ts",
        "default": "./dist/esm/components/index.mjs"
      },
      "require": {
        "types": "./dist/types/src/components/index.d.ts",
        "default": "./dist/cjs/components/index.js"
      }
    },
    "./theme": {
      "react-native": {
        "types": "./dist/types/src/theme/index.d.ts",
        "default": "./dist/jsx/theme/index.jsx"
      },
      "import": {
        "types": "./dist/types/src/theme/index.d.ts",
        "default": "./dist/esm/theme/index.mjs"
      },
      "require": {
        "types": "./dist/types/src/theme/index.d.ts",
        "default": "./dist/cjs/theme/index.js"
      }
    },
    "./tamagui.config": {
      "react-native": {
        "types": "./dist/types/tamagui.config.d.ts",
        "default": "./dist/jsx/tamagui.config.jsx"
      },
      "import": {
        "types": "./dist/types/tamagui.config.d.ts",
        "default": "./dist/esm/tamagui.config.mjs"
      },
      "require": {
        "types": "./dist/types/tamagui.config.d.ts",
        "default": "./dist/cjs/tamagui.config.js"
      }
    },
    "./tamagui.build": {
      "react-native": {
        "types": "./dist/types/tamagui.build.d.ts",
        "default": "./dist/jsx/tamagui.build.jsx"
      },
      "import": {
        "types": "./dist/types/tamagui.build.d.ts",
        "default": "./dist/esm/tamagui.build.mjs"
      },
      "require": {
        "types": "./dist/types/tamagui.build.d.ts",
        "default": "./dist/cjs/tamagui.build.js"
      }
    },
    "./test": {
      "import": {
        "types": "./test/index.ts",
        "default": "./test/index.ts"
      },
      "require": {
        "types": "./test/index.ts",
        "default": "./test/index.ts"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "test",
    "tamagui.config.ts",
    "tamagui.build.ts"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:esm-cjs && npm run build:jsx && npm run build:types",
    "build:esm-cjs": "vite build",
    "build:jsx": "vite build --mode jsx",
    "build:types": "tsc --emitDeclarationOnly --outDir dist/types",
    "dev": "vite build --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src/",
    "format:write": "prettier --write src/",
    "test": "bun test",
    "test:unit": "bun test -t '[UNIT]'",
    "test:coverage": "bun test --coverage",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "storybook:serve": "bunx serve storybook-static",
    "storybook:deploy:gh-pages": "gh-pages -d storybook-static",
    "storybook:deploy:netlify": "netlify deploy --dir=storybook-static --prod",
    "storybook:deploy:vercel": "vercel --cwd storybook-static"
  },
  "dependencies": {
    "tamagui": "^1.144.4",
    "@tamagui/core": "^1.144.4",
    "@tamagui/config": "^1.144.4",
    "@tamagui/web": "^1.144.4",
    "@tamagui/animations-motion": "^1.144.4",
    "@tamagui/animations-moti": "^1.144.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "^0.81.5",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.8.9",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@storybook/types": "^8.6.14",
    "@tamagui/metro-plugin": "^1.144.4",
    "@tamagui/vite-plugin": "^1.144.4",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "^1.3.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "storybook": "^8.6.14",
    "typescript": "^5.9.3",
    "vite": "^6.2.2"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "react-native-reanimated": ">=3.0.0",
    "moti": ">=0.30.0"
  },
  "peerDependenciesMeta": {
    "react-native-reanimated": {
      "optional": true
    },
    "moti": {
      "optional": true
    }
  },
  "sideEffects": false,
  "keywords": [
    "tamagui",
    "ui",
    "components",
    "react",
    "react-native",
    "cross-platform"
  ],
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/rafalopilowski/mirai-app.git",
    "directory": "packages/ui"
  }
}
