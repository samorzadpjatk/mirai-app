{
  "name": "@integral-2025-app/common-types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./models/user": {
      "import": "./dist/models/user.js",
      "types": "./dist/models/user.d.ts",
      "default": "./dist/models/user.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check": "eslint . && tsc --noEmit",
