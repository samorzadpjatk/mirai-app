{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true
    /* Removed defaults (emitDeclarationOnly/composite/noEmit) for cleanliness */
  },
  "include": ["src/**/*", "vitest.config.ts", "vitest.setup.ts", "prisma"],
  "exclude": ["node_modules", "dist", "prisma/lib/**/*"]
}
