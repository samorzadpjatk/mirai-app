{
  "name": "@mirai-app/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "clean": "rm -rf node_modules",
    "db:migrate": "bunx --bun prisma migrate deploy",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:db": "docker compose -f compose.yml up -d && bun test",
    "test:db:stop": "docker compose -f compose.yml down"
  },
  "dependencies": {
    "@mirai-app/supabase": "workspace:*",
    "@prisma/client": "^7.3.0",
    "@prisma/adapter-pg": "^7.3.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.0",
    "prisma": "^7.3.0",
    "typescript": "^5.9.3"
  }
}
