{
  "name": "@mirai-app/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "clean": "rm -rf node_modules",
    "db:migrate": "bunx --bun prisma migrate deploy",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mirai-app/supabase": "workspace:*",
    "@prisma/client": "^7.3.0",
    "@prisma/adapter-pg": "^7.3.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.0",
    "prisma": "^7.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}