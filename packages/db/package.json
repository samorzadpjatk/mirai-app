{
  "name": "@mirai-app/db",
  "version": "0.1.0",
  "nx": { "tags": ["type:package", "scope:db"] },
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "import": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    },
    "./test-helper": {
      "import": "./src/pglite.ts",
      "default": "./src/pglite.ts"
    }
  },
  "scripts": {
    "clean": "rm -rf node_modules",
    "build": "tsc -b",
    "db:migrate": "bunx --bun drizzle-kit migrate",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:push": "bunx --bun drizzle-kit push",
    "db:studio": "bunx --bun drizzle-kit studio",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bunx --bun vitest --run --changed",
    "test:ci": "bunx --bun vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "^4.1.8",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}