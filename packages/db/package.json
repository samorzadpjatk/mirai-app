{
  "name": "@mirai-app/db",
  "version": "0.1.0",
  "nx": { "tags": ["type:package", "scope:db"] },
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./test-helper": {
      "import": "./src/test-helper.ts",
      "default": "./src/test-helper.ts"
    }
  },
  "scripts": {
    "clean": "rm -rf node_modules",
    "build": "tsc -b",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run --changed --passWithNoTests",
    "test:ci": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.8",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}