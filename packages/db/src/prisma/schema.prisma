// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client"
  output        = "./lib"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
  runtime       = "bun"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  MODERATOR
  SERVICE
}

enum SubmissionType {
  IMAGE
  MULTI_IMAGE
  VIDEO
  TEXT
  IMAGE_LOCATION
  LOCATION
  QR_CODE
}

enum ScoringCategory {
  SPEED
  UNLIMITED
  JUDGED_STAFF
  PEER_VOTING
}

enum ChallengeStatus {
  HIDDEN
  VISIBLE
  ACTIVE
  VOTING_PHASE
  COMPLETED
  CANCELLED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                        String                 @id @default(uuid())
  authUserId                String                @unique
  firstName                 String
  lastName                  String
  hasAvatar                 Boolean                @default(false)
  role                      Role                   @default(USER)
  organizerGroup            Group[]                @relation("UserOrganizerGroups")
  coinTransactionsAdmin     CoinTransaction[]      @relation("UserCoinTransactionsAdmin")
  notificationSchedules     NotificationSchedule[] @relation("NotificationScheduleAdmin")
  receivedPushNotifications NotificationPush[]
  sentPushNotifications     Notification[]         @relation("NotificationAdmin")
  pushSubscriptions         PushSubscription[]
  createdEvents             Event[]
  userEvents                UserEvent[]
  location                  Location?
  locationsSharedWithMe     Location[]             @relation("LocationSharingUsers")
  sentLocationRequests      LocationSharingRequest[] @relation("SentLocationSharingRequests")
  receivedLocationRequests  LocationSharingRequest[] @relation("ReceivedLocationSharingRequests")
  trips                     TripParticipant[]
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  challengeSubmissions ChallengeSubmission[]
  createdRewards       Reward[]                 @relation("RewardCreator")
  rewardPurchases      RewardPurchase[]         @relation("RewardPurchaser")
}

model Trip {
  id                     String                 @id @default(cuid())
  name                   String
  description            String?
  startDate              DateTime
  endDate                DateTime
  backgroundImagePath    String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  groups                 Group[]
  participants           TripParticipant[]
  notifications          Notification[]
  notificationSchedules  NotificationSchedule[]
  notificationDeliveries NotificationDelivery[]
  challenges             Challenge[]
  rewards                Reward[]
}

model TripParticipant {
  id                String             @id @default(cuid())
  userId            String
  tripId            String
  groupId           String?
  wristNumber       String?
  houseNumber       String?
  role              String             @default("MEMBER") // MEMBER, LEADER
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id])
  trip              Trip               @relation(fields: [tripId], references: [id])
  group             Group?             @relation(fields: [groupId], references: [id])
  challengeVotes    ChallengeVote[]
  submissionReports SubmissionReport[]

  @@unique([userId, tripId])
  @@unique([tripId, wristNumber])
  @@index([tripId, groupId])
}

model Event {
  id               String      @id @default(cuid())
  creator          User        @relation(fields: [creatorId], references: [id])
  creatorId        String
  organizerGroup   Group?      @relation(fields: [organizerGroupId], references: [id])
  organizerGroupId String?
  title            String
  startTime        DateTime
  endTime          DateTime
  location         String
  description      String
  files            String[]
  userEvents       UserEvent[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model UserEvent {
  user         User     @relation(fields: [userId], references: [id])
  userId       String
  event        Event    @relation(fields: [eventId], references: [id])
  eventId      String
  interestedIn Boolean  @default(false)
  enlistedIn   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([userId, eventId])
}

model Group {
  id               String            @id @default(uuid())
  tripId           String
  name             String
  description      String?
  image            String?
  organizerId      String
  organizer        User              @relation("UserOrganizerGroups", fields: [organizerId], references: [id])
  code             String            @unique
  trip             Trip              @relation(fields: [tripId], references: [id])
  participants     TripParticipant[]
  coins            Int               @default(0)
  coinTransactions CoinTransaction[]
  organizedEvents  Event[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  challengeSubmissions ChallengeSubmission[]
  rewardPurchases      RewardPurchase[]
}

model Challenge {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id])

  name        String
  description String?
  image       String?

  submissionType  SubmissionType
  scoringCategory ScoringCategory

  isRecurring    Boolean @default(false)
  dailyStartTime String?
  dailyEndTime   String?

  basePoints        Int  @default(0)
  firstPlacePoints  Int?
  secondPlacePoints Int?
  thirdPlacePoints  Int?

  status          ChallengeStatus @default(HIDDEN)
  startTime       DateTime?
  endTime         DateTime?
  votingStartTime DateTime?
  votingEndTime   DateTime?

  targetLatitude  Float?
  targetLongitude Float?

  autoApprove Boolean @default(false)

  submissions ChallengeSubmission[]
  votes       ChallengeVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripId, status])
  @@index([isRecurring])
}

model ChallengeSubmission {
  id          String    @id @default(cuid())
  challengeId String
  groupId     String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  imageIds    String[] @default([])
  videoId     String?
  textContent String?
  latitude    Float?
  longitude   Float?

  status          SubmissionStatus @default(PENDING)
  reviewedById    String?
  reviewedBy      User?            @relation(fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?

  awardedPoints Int  @default(0)
  bonusPoints   Int  @default(0)
  ranking       Int?

  voteCount Int   @default(0)
  voteScore Float @default(0)

  votes   ChallengeVote[]
  reports SubmissionReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([challengeId, groupId])
  @@index([challengeId, status])
  @@index([groupId])
}

model ChallengeVote {
  id           String @id @default(cuid())
  challengeId  String
  submissionId String
  voterId      String

  challenge  Challenge           @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  submission ChallengeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  voter      TripParticipant     @relation(fields: [voterId], references: [id], onDelete: Cascade)

  votePosition     Int
  votePoints       Int
  normalizedWeight Float @default(1.0)

  votedAt DateTime @default(now())

  @@unique([challengeId, submissionId, voterId])
  @@index([challengeId])
  @@index([submissionId])
}

model SubmissionReport {
  id           String              @id @default(cuid())
  submissionId String
  reporterId   String
  submission   ChallengeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reporter     TripParticipant     @relation(fields: [reporterId], references: [id])

  reason  String
  details String?

  createdAt DateTime @default(now())

  @@index([submissionId])
}

model CoinTransaction {
  id        String   @id @default(uuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id])
  amount    Int
  reason    String? // Optional reason for the transaction
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  adminId   String
  admin     User     @relation("UserCoinTransactionsAdmin", fields: [adminId], references: [id])
}

model NotificationSchedule {
  id                     String                          @id @default(cuid())
  tripId                 String?
  trip                   Trip?                           @relation(fields: [tripId], references: [id])
  name                   String
  notificationType       String // e.g., "custom", "ranking"
  notificationTitle      String? // For custom notifications
  notificationBody       String? // For custom notifications
  notificationUrl        String? // For custom notifications
  startDate              DateTime // When the schedule starts
  endDate                DateTime // When the schedule ends
  hour                   Int // Hour of the day (0-23)
  minute                 Int                             @default(0) // Minute of the hour (0-59)
  isActive               Boolean                         @default(true)
  lastRun                DateTime? // When was this schedule last executed
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt
  createdById            String // Admin who created this schedule
  createdBy              User                            @relation("NotificationScheduleAdmin", fields: [createdById], references: [id])
  notificationExecutions NotificationScheduleExecution[]
}

model Notification {
  id                 String                          @id @default(cuid())
  tripId             String?
  trip               Trip?                           @relation(fields: [tripId], references: [id])
  title              String // Notification title
  body               String // Notification body/message
  url                String // Optional URL to open when the notification is clicked
  pushes             NotificationPush[]
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt
  createdById        String // Admin who created this notification
  createdBy          User                            @relation("NotificationAdmin", fields: [createdById], references: [id])
  scheduleExecutions NotificationScheduleExecution[]
  delivery           NotificationDelivery?
}

model NotificationScheduleExecution {
  notificationId String
  notification   Notification         @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  scheduleId     String
  schedule       NotificationSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  executedAt     DateTime             @default(now())

  @@id([notificationId, scheduleId, executedAt])
}

model NotificationPush {
  targetUserId   String
  targetUser     User         @relation(fields: [targetUserId], references: [id], onDelete: Cascade)
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  status         String // sent or failed
  sentAt         DateTime? // When the notification was actually sent
  failureReason  String? // Reason for failure if status is 'failed'

  @@id([targetUserId, notificationId])
}

model NotificationDelivery {
  id                  String       @id @default(cuid())
  tripId              String?
  trip                Trip?        @relation(fields: [tripId], references: [id])
  notificationId      String       @unique
  notification        Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  scheduleId          String?
  deliveryStartedAt   DateTime     @default(now())
  deliveryCompletedAt DateTime?
  totalRecipients     Int          @default(0)
  successCount        Int          @default(0)
  failureCount        Int          @default(0)
  errors              String?
  status              String       @default("pending")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([deliveryStartedAt])
  @@index([status])
  @@index([scheduleId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String // Expo push token
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, token])
}

// https://docs.expo.dev/versions/latest/sdk/location/#locationobject
model Location {
  id                         String    @id @default(cuid())
  userId                     String    @unique
  user                       User      @relation(fields: [userId], references: [id])
  timestamp                  DateTime  @default(now())
  isSharingLocation          Boolean   @default(false)
  accuracy                   Float?
  altitude                   Float?
  altitudeAccuracy           Float?
  heading                    Float?
  latitude                   Float?
  longitude                  Float?
  speed                      Float?
  usersToShareWith           User[]    @relation("LocationSharingUsers")
  lastInactivityNotification DateTime?
}

enum LocationSharingRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model LocationSharingRequest {
  id         String                        @id @default(cuid())
  senderId   String
  receiverId String
  sender     User                          @relation("SentLocationSharingRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User                          @relation("ReceivedLocationSharingRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  status     LocationSharingRequestStatus  @default(PENDING)
  createdAt  DateTime                      @default(now())
  updatedAt  DateTime                      @updatedAt

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
}

model Reward {
  id               String   @id @default(cuid())
  name             String
  description      String
  availableQuantity Int
  image            String?
  coinCost         Int
  tripId           String
  trip             Trip     @relation(fields: [tripId], references: [id])
  createdById      String
  createdBy        User     @relation("RewardCreator", fields: [createdById], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  purchases        RewardPurchase[]
  
  @@index([tripId])
}

model RewardPurchase {
  id           String   @id @default(cuid())
  rewardId     String
  reward       Reward   @relation(fields: [rewardId], references: [id])
  groupId      String
  group        Group    @relation(fields: [groupId], references: [id])
  quantity     Int
  totalCost    Int
  purchasedById String
  purchasedBy  User     @relation("RewardPurchaser", fields: [purchasedById], references: [id])
  purchasedAt  DateTime @default(now())
  
  @@index([rewardId])
  @@index([groupId])
}
