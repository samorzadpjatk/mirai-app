{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "plugins": [
    "@nx/expo",
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.build.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "targetName": "test",
        "ciTargetName": "test:ci",
        "configName": "vitest.config.ts"
      }
    },
    {
      "plugin": "@nx/jest",
      "options": {
        "targetName": "test",
        "ciTargetName": "test:ci"
      }
    },
    {
      "plugin": "@nx-tools/nx-container",
      "options": {
        "targetName": "container"
      }
    },
    {
      "plugin": "@berenddeboer/nx-knip",
      "options": {
        "targetName": "knip"
      }
    }
  ],
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build",
        "db:generate"
      ],
      "outputs": [
        "{projectRoot}/dist/**",
        "{projectRoot}/.astro/**"
      ],
      "cache": true
    },
    "clean": {
      "cache": true
    },
    "container": {
      "dependsOn": [
        "build"
      ],
      "cache": true
    },
    "db:generate": {
      "outputs": [
        "{projectRoot}/drizzle/**"
      ],
      "cache": true
    },
    "dev": {
      "dependsOn": [
        "db:generate"
      ],
      "cache": false
    },
    "knip": {
      "cache": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "cache": true
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "cache": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "{projectRoot}/coverage/**"
      ],
      "cache": true
    },
    "test:ci": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "{projectRoot}/coverage/**"
      ],
      "cache": true
    },
    "test:coverage": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "{projectRoot}/coverage/**"
      ],
      "cache": true
    },
    "test:watch": {
      "cache": false
    },
    "format:check": {
      "cache": true
    },
    "format:write": {
      "cache": true
    }
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/nx.json"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/**/*.test.tsx",
      "!{projectRoot}/**/__tests__/**",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.spec.tsx"
    ]
  },
  "generators": {
    "@nx/expo:application": {
      "linter": "eslint",
      "unitTestRunner": "jest",
      "e2eTestRunner": "none"
    },
    "@nx/expo:library": {
      "linter": "eslint",
      "unitTestRunner": "jest"
    }
  },
  "nxCloudAccessToken": "",
  "analytics": false
}