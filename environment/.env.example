PG_META_CRYPTO_KEY=your-encryption-key-32-chars-min

# MinIO (S3 compatible) - used for Storage in local dev
# For production, change these to secure values
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=pjapp
MINIO_REGION=pl-waw-1
S3_ENDPOINT=http://minio:9000

############
# Database - You can change these to any PostgreSQL database that has logical replication enabled.
############

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# default user is postgres


############
# Supavisor -- Database pooler
############
# Port Supavisor listens on for transaction pooling connections
POOLER_PROXY_PORT_TRANSACTION=6543
# Maximum number of PostgreSQL connections Supavisor opens per pool
POOLER_DEFAULT_POOL_SIZE=20
# Maximum number of client connections Supavisor accepts per pool
POOLER_MAX_CLIENT_CONN=100
# Unique tenant identifier
POOLER_TENANT_ID=your-tenant-id
# Pool size for internal metadata storage used by Supavisor
# This is separate from client connections and used only by Supavisor itself
POOLER_DB_POOL_SIZE=5

# Host port to map Supavisor's Postgres listener to avoid colliding with a host Postgres service
# Change this if you already run a Postgres instance on :5432
SUPAVISOR_HOST_POSTGRES_PORT=5433

# Minio host port mappings (API and console). Change these if 9000/9001 are in use by other services
MINIO_HTTP_PORT=9000
MINIO_CONSOLE_PORT=9001


############
# API Proxy - Configuration for the Kong Reverse proxy.
############

KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# Public URL exposed by Kong (used by Studio and clients)
SUPABASE_PUBLIC_URL=http://localhost:8000


############
# API - Configuration for PostgREST.
############

PGRST_DB_SCHEMAS=public,storage,graphql_public


############
# Auth - Configuration for the GoTrue authentication server.
############

## General
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
API_EXTERNAL_URL=http://localhost:8000

## Mailer Config
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

# URL to the OTP-only magic link template served inside the Docker network by the
# `email-templates` service. Change this to your public CDN/host in production
# if you prefer external hosting.
MAILER_TEMPLATES_MAGIC_LINK=http://email-templates/magic_link.html
MAILER_SUBJECTS_MAGIC_LINK="Twój kod logowania — Mirai"

## Email auth
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=fake_sender
ENABLE_ANONYMOUS_USERS=false

## Phone auth
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

############
# Service-to-Service Authentication
############

# Token used for internal service-to-service communication
# Must match the SERVICE_ACCOUNT_TOKEN configured in apps/backend-server/.env
# and the notification sender microservice
SERVICE_ACCOUNT_TOKEN=your-service-account-token-here