.git
.gitignore
**/.DS_Store

# Dependencies
node_modules
*/node_modules
*/*/node_modules

# Environment & Secrets
.env*
**/.env.*

# NX
.nx/
**/.nx/

# Build outputs
dist/
build/
coverage/
*.log

# Temporary files
.tmp-*
*.tmp
*.temp

# Development tooling
.husky/
.agents/
.claude/
.specs/

# Documentation
docs/
*.md
!**/README.md

# Local dev environment
environment/
docker-compose*.yml

# Include workspace manifests so Bun lockfile validation passes,
# but exclude their source since they're not needed for backend builds
apps/native/*
!apps/native/package.json
apps/seed/*
!apps/seed/package.json

# Expo / Mobile
.expo/
.expo-shared/
web-build/
