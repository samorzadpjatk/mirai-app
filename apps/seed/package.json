{
  "name": "@mirai-app/seed",
  "module": "index.ts",
  "type": "module",
  "nx": { "tags": ["type:app", "scope:cli"] },
  "private": true,
  "license": "AGPL-3.0",
  "scripts": {
    "db:seed:dev": "bun run --env-file=.env.dev index.ts",
    "db:seed:prod": "bun run --env-file=.env.prod index.ts --prod",
    "db:reset:dev": "bun run --env-file=.env.dev reset.ts",
    "db:reset:prod": "bun run --env-file=.env.prod reset.ts --prod",
    "db:fresh:dev": "bun run db:reset:dev && bun run db:seed:dev",
    "db:fresh:prod": "bun run db:reset:prod && bun run db:seed:prod",
    "db:generate": "cd ../../packages/db && bun run db:generate",
    "db:migrate": "cd ../../packages/db && bun run db:migrate",
    "db:migrate:deploy": "cd ../../packages/db && bun run db:migrate",
    "db:migrate:dev": "cd ../../packages/db && bun run db:migrate",
    "db:migrate:prod": "cd ../../packages/db && bun run db:migrate",
    "db:push:dev": "cd ../../packages/db && bunx --bun --env-file=../../apps/seed/.env.dev drizzle-kit push",
    "db:push:prod": "cd ../../packages/db && bunx --bun --env-file=../../apps/seed/.env.prod drizzle-kit push",
    "db:studio:dev": "cd ../../packages/db && bunx --bun --env-file=../../apps/seed/.env.dev drizzle-kit studio",
    "db:studio:prod": "cd ../../packages/db && bunx --bun --env-file=../../apps/seed/.env.prod drizzle-kit studio",
    "dev": "bun run --env-file=.env.dev index.ts",
    "prod": "bun run --env-file=.env.prod index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mirai-app/db": "workspace:*",
    "@mirai-app/shared": "workspace:*",
    "@mirai-app/supabase": "workspace:*",
    "csv-parse": "^6.1.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
