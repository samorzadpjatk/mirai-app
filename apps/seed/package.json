{
  "name": "@mirai-app/seed",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0",
  "scripts": {
    "db:seed:dev": "bun run --env-file=.env.dev index.ts",
    "db:seed:prod": "bun run --env-file=.env.prod index.ts --prod",
    "db:generate": "bunx --bun prisma generate --config ../../packages/db/prisma.config.ts",
    "db:migrate": "bunx --bun prisma migrate --config ../../packages/db/prisma.config.ts",
    "db:migrate:deploy": "bunx --bun prisma migrate deploy --config ../../packages/db/prisma.config.ts",
    "db:migrate:dev": "bunx --bun --env-file=.env.dev prisma migrate dev --config ../../packages/db/prisma.config.ts",
    "db:migrate:prod": "bunx --bun --env-file=.env.prod prisma migrate dev --config ../../packages/db/prisma.config.ts",
    "db:reset": "bunx --bun prisma migrate reset --config ../../packages/db/prisma.config.ts",
    "db:reset:dev": "bunx --bun --env-file=.env.dev prisma migrate reset --config ../../packages/db/prisma.config.ts",
    "db:reset:prod": "bunx --bun --env-file=.env.prod prisma migrate reset --config ../../packages/db/prisma.config.ts",
    "db:push:dev": "bunx --bun --env-file=.env.dev prisma db push --config ../../packages/db/prisma.config.ts",
    "db:push:prod": "bunx --bun --env-file=.env.prod prisma db push --config ../../packages/db/prisma.config.ts",
    "db:studio:dev": "bunx --bun --env-file=.env.dev prisma studio --config ../../packages/db/prisma.config.ts",
    "db:studio:prod": "bunx --bun --env-file=.env.prod prisma studio --config ../../packages/db/prisma.config.ts",
    "db:format": "bunx --bun prisma format --config ../../packages/db/prisma.config.ts",
    "dev": "bun run --env-file=.env.dev index.ts",
    "prod": "bun run --env-file=.env.prod index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mirai-app/db": "workspace:*",
    "@mirai-app/supabase": "workspace:*",
    "csv-parse": "^6.1.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@vitest/coverage-v8": "^3.0.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
