{
  "expo": {
    "name": "MIRAI",
    "slug": "mirai",
    "version": "1.1.0",
    "extra": {
      "eas": {
        "projectId": "f6a5489a-21d3-4cf2-8dec-f98151979b91"
      },
      "router": {
        "root": "./src/app"
      }
    },
    "platforms": [
      "ios",
      "android"
    ],
    "owner": "samorzadpjatk",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "native",
    "notification": {
      "icon": "./assets/mirai_logo.png",
      "color": "#000000",
      "androidMode": "default",
      "androidCollapsedTitle": "MIRAI",
      "iosDisplayInForeground": true
    },
    "splash": {
      "image": "./assets/mirai_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "icon": "./assets/ios_logo.icon",
      "supportsTablet": false,
      "bundleIdentifier": "edu.samorzadpjatk.mirai",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app uses your location to provide nearby features.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app needs access to your location even when the app is in the background.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "development"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/mirai_logo.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "edu.samorzadpjatk.mirai",
      "googleServicesFile": "google-services.json"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      [
        "expo-asset",
        {
          "assets": [
            "./assets/mirai_logo.png"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "This app uses your location to provide nearby features.",
          "locationAlwaysAndWhenInUsePermission": "This app needs access to your location even when the app is in the background.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-notifications",
        {
          "icon": "./assets/mirai_logo.png",
          "color": "#000000",
          "sounds": []
        }
      ],
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-video"
    ]
  }
}
