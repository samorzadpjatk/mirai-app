{
  "expo": {
    "name": "MIRAI",
    "slug": "mirai",
    "version": "15.8.0",
    "extra": {
      "eas": {
        "projectId": "f6a5489a-21d3-4cf2-8dec-f98151979b91"
      },
      "router": {
        "root": "./src/app"
      }
    },
    "platforms": [
      "ios",
      "android"
    ],
    "owner": "samorzadpjatk",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "native",
    "ios": {
      "icon": "./assets/ios_logo.icon",
      "supportsTablet": false,
      "bundleIdentifier": "edu.samorzadpjatk.mirai",
      "buildNumber": "2",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app uses your location to provide nearby features.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app needs access to your location even when the app is in the background.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "92Z87C8SAM",
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/mirai_adaptive_logo_foreground.png",
        "monochromeImage": "./assets/mirai_adaptive_logo_monochrome.png",
        "backgroundImage": "./assets/mirai_adaptive_logo_background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "edu.samorzadpjatk.mirai",
      "googleServicesFile": "credentials/android/google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "versionCode": 9
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      [
        "expo-asset",
        {
          "assets": [
            "./assets/mirai_logo.png"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "This app uses your location to provide nearby features.",
          "locationAlwaysAndWhenInUsePermission": "This app needs access to your location even when the app is in the background.",
          "locationAlwaysPermission": "This app needs access to your location even when the app is in the background to share your location with trip participants.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-notifications",
        {
          "icon": "./assets/mirai_notification_logo.png",
          "color": "#000000",
          "sounds": []
        }
      ],
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-video",
      [
        "expo-build-properties",
        {
          "ios": {
            "newArchEnabled": true
          },
          "android": {
            "newArchEnabled": true
          }
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f6a5489a-21d3-4cf2-8dec-f98151979b91"
    }
  }
}
