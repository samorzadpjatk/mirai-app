default_platform(:android)

require "json"
require "rubygems"
require "open3"
require "fileutils"
require "digest"
require "pathname"
require "shellwords"
require "tmpdir"
require "securerandom"
require "base64"

ENV["PATH"] = [
  "/opt/homebrew/bin",
  "/opt/homebrew/sbin",
  Gem.bindir,
  File.expand_path("~/.gem/bin"),
  File.expand_path("~/.asdf/shims"),
  ENV["PATH"],
].compact.map(&:to_s).reject(&:empty?).uniq.join(":")

# Shared helper methods for both platforms
def sh_capture!(command)
  stdout, stderr, status = Open3.capture3(command)
  UI.user_error!("Command failed: #{command}\n#{stderr}") unless status.success?
  stdout.strip
end

# Execute shell command without logging (for sensitive operations)
def sh_silent(command)
  stdout, stderr, status = Open3.capture3(command)
  unless status.success?
    UI.user_error!("Command failed with exit code #{status.exitstatus}\n#{stderr}")
  end
  stdout
end

def mask_sensitive_value(value)
  return "" if value.nil? || value.to_s.strip.empty?
  "***HIDDEN***"
end

# Hide sensitive environment variables from Fastlane output
def hide_sensitive_env_vars!
  sensitive_keys = %w[
    ANDROID_KEYSTORE_PASSWORD
    ANDROID_KEY_PASSWORD
    IOS_DIST_CERT_PASSWORD
    IOS_KEYCHAIN_PASSWORD
    IOS_ASC_KEY_PATH
    FASTLANE_PASSWORD
    MATCH_PASSWORD
    GH_TOKEN
    GITHUB_TOKEN
  ]

  sensitive_keys.each do |key|
    next unless ENV[key]
    ENV["FASTLANE_HIDE_#{key}"] = "true"
  end
end

# Sanitize lane context to prevent sensitive data leaks
def sanitize_lane_context!
  sensitive_context_keys = [
    :IOS_KEYCHAIN_PASSWORD,
    :IOS_DIST_CERT_PASSWORD,
    :ANDROID_KEYSTORE_PASSWORD,
    :ANDROID_KEY_PASSWORD,
  ]

  sensitive_context_keys.each do |key|
    if Actions.lane_context[key]
      # Store internally but mark as hidden
      Actions.lane_context["#{key}_HIDDEN".to_sym] = true
    end
  end
end

def resolve_credentials_path
  candidates = [
    "credentials.json",
    File.expand_path("../credentials.json"),
    File.expand_path("../../credentials.json"),
  ].uniq
  candidates.find { |path| File.exist?(path) } || candidates.first
end

def resolve_app_json_path
  candidates = [
    "app.json",
    File.expand_path("../app.json"),
    File.expand_path("../../app.json"),
  ].uniq
  candidates.find { |p| File.exist?(p) }
end

def app_root_dir
  app_json_path = resolve_app_json_path
  UI.user_error!("app.json not found in any expected location") unless app_json_path
  File.dirname(File.expand_path(app_json_path))
end

def load_app_json
  path = resolve_app_json_path
  UI.user_error!("app.json not found in any expected location") unless path
  JSON.parse(File.read(path))
end

def app_version_name
  load_app_json.dig("expo", "version")
end

def latest_semver_tag
  tags = sh_capture!("git tag --sort=-v:refname").split("\n").map(&:strip).reject(&:empty?)
  tags.each do |tag|
    normalized = tag.sub(/^v/, "")
    return tag if normalized.match?(/^\d+\.\d+\.\d+$/)
  end
  nil
rescue StandardError
  nil
end

def make_path_absolute(path, base_dir)
  Pathname.new(path).absolute? ? path : File.expand_path(path, base_dir)
end

# Global hooks for security
before_all do |lane, options|
  hide_sensitive_env_vars!
  UI.message("Starting lane: #{lane}")
end

after_all do |lane|
  # Clean up sensitive data from lane context after execution
  sensitive_keys = [
    :IOS_KEYCHAIN_PASSWORD,
    :IOS_INSTALLED_PROFILE_PATH,
    :ANDROID_KEYSTORE_PASSWORD,
    :ANDROID_KEY_PASSWORD,
  ]

  sensitive_keys.each do |key|
    Actions.lane_context.delete(key) if Actions.lane_context[key]
  end

  UI.success("Lane #{lane} completed successfully")
end

error do |lane, exception|
  # Ensure sensitive data is cleaned even on error
  sensitive_keys = [
    :IOS_KEYCHAIN_PASSWORD,
    :IOS_INSTALLED_PROFILE_PATH,
    :ANDROID_KEYSTORE_PASSWORD,
    :ANDROID_KEY_PASSWORD,
  ]

  sensitive_keys.each do |key|
    Actions.lane_context.delete(key) if Actions.lane_context[key]
  end

  UI.error("Lane #{lane} failed: #{exception.message}")
end

platform :android do
  REQUIRED_ENV_BUILD = %w[
    ANDROID_APP_PACKAGE
    PLAY_JSON_KEY_PATH
    ANDROID_KEYSTORE_PATH
    ANDROID_KEYSTORE_PASSWORD
    ANDROID_KEY_ALIAS
    ANDROID_KEY_PASSWORD
    ANDROID_SIGNING_LINEAGE
  ].freeze

  REQUIRED_ENV_PLAY = %w[
    ANDROID_APP_PACKAGE
    PLAY_JSON_KEY_PATH
    ANDROID_SIGNING_LINEAGE
  ].freeze

  NON_PROD_TRACKS = %w[internal beta].freeze
  PROD_TRACK = "production"

  def ensure_env!(key)
    value = ENV[key]
    unless value.nil? || value.strip.empty?
      # Verify the path exists if it looks like a file path
      if value.start_with?("/") && !File.exist?(value)
        UI.user_error!("File not found for #{key}: #{value}")
      end
      return value
    end

    # Provide helpful error message with context about auto-detection
    case key
    when "PLAY_JSON_KEY_PATH"
      checked_paths = [
        "PLAY_JSON_KEY_PATH environment variable",
        "credentials.json[android.playJsonKeyPath]",
        "credentials/android/play-service-account.json",
        "credentials/android/play-credentials.json",
        "credentials/android/service-account.json",
      ]
      UI.user_error!(
        "Missing required environment variable: #{key}\n" \
        "Checked paths:\n" \
        "  #{checked_paths.map { |p| "• #{p}" }.join("\n  ")}"
      )
    when "ANDROID_KEYSTORE_PATH"
      checked_paths = [
        "ANDROID_KEYSTORE_PATH environment variable",
        "credentials.json[android.keystore.keystorePath]",
      ]
      UI.user_error!(
        "Missing required environment variable: #{key}\n" \
        "Checked paths:\n" \
        "  #{checked_paths.map { |p| "• #{p}" }.join("\n  ")}"
      )
    else
      UI.user_error!("Missing required environment variable: #{key}")
    end
  end

   def bootstrap_android_release_env!
     credentials_path = resolve_credentials_path
     credentials = {}
     credentials_dir = File.dirname(File.expand_path(credentials_path))

     if File.exist?(credentials_path)
       credentials = JSON.parse(File.read(credentials_path))
     end

     keystore = credentials.dig("android", "keystore") || {}
     keystore_path = keystore["keystorePath"].to_s.strip
     if ENV["ANDROID_KEYSTORE_PATH"].to_s.strip.empty? && !keystore_path.empty?
       ENV["ANDROID_KEYSTORE_PATH"] = make_path_absolute(keystore_path, credentials_dir)
     end

     ENV["ANDROID_KEYSTORE_PASSWORD"] = keystore["keystorePassword"].to_s if ENV["ANDROID_KEYSTORE_PASSWORD"].to_s.strip.empty? && !keystore["keystorePassword"].to_s.strip.empty?
     ENV["ANDROID_KEY_ALIAS"] = keystore["keyAlias"].to_s if ENV["ANDROID_KEY_ALIAS"].to_s.strip.empty? && !keystore["keyAlias"].to_s.strip.empty?
     ENV["ANDROID_KEY_PASSWORD"] = keystore["keyPassword"].to_s if ENV["ANDROID_KEY_PASSWORD"].to_s.strip.empty? && !keystore["keyPassword"].to_s.strip.empty?

     if ENV["ANDROID_APP_PACKAGE"].to_s.strip.empty?
       package_from_credentials = credentials.dig("android", "appPackage").to_s.strip
       if !package_from_credentials.empty?
         ENV["ANDROID_APP_PACKAGE"] = package_from_credentials
       else
         package_from_config = app_package_from_config.to_s.strip
         ENV["ANDROID_APP_PACKAGE"] = package_from_config unless package_from_config.empty?
       end
     end

     if ENV["ANDROID_SIGNING_LINEAGE"].to_s.strip.empty?
       lineage = credentials.dig("android", "signingLineage").to_s.strip
       if lineage.empty?
         inferred = File.basename(ENV["ANDROID_KEYSTORE_PATH"].to_s, File.extname(ENV["ANDROID_KEYSTORE_PATH"].to_s)).to_s.strip
         lineage = inferred.empty? ? "play-release" : inferred
       end
       ENV["ANDROID_SIGNING_LINEAGE"] = lineage
     end

     if ENV["PLAY_JSON_KEY_PATH"].to_s.strip.empty?
       candidates = [
         credentials.dig("android", "playJsonKeyPath").to_s.strip,
         "credentials/android/play-service-account.json",
         "credentials/android/play-credentials.json",
         "credentials/android/service-account.json",
       ].reject(&:empty?)
       detected = candidates.find do |path|
         absolute = make_path_absolute(path, credentials_dir)
         File.exist?(absolute)
       end
       if detected
         ENV["PLAY_JSON_KEY_PATH"] = make_path_absolute(detected, credentials_dir)
       end
     end
   end

  def verify_android_google_services_file!
    relative_path = load_app_json.dig("expo", "android", "googleServicesFile").to_s.strip
    return if relative_path.empty?

    absolute_path = make_path_absolute(relative_path, app_root_dir)
    return if File.exist?(absolute_path)

    UI.user_error!(
      "Missing Android google-services.json at #{absolute_path}.\n" \
      "Set expo.android.googleServicesFile in app.json to an existing file path or add the file there."
    )
  end

  def app_package_from_config
    load_app_json.dig("expo", "android", "package")
  end

  def resolve_submit_artifact_path!(options)
    explicit_artifact = (options[:artifact_path] || ENV["ANDROID_ARTIFACT_PATH"]).to_s.strip
    unless explicit_artifact.empty?
      candidate = make_path_absolute(explicit_artifact, Dir.pwd)
      UI.user_error!("Artifact not found: #{candidate}") unless File.exist?(candidate)
      return candidate
    end

    app_root = app_root_dir
    dist_dir = File.join(app_root, "dist", "android")
    metadata_path = (options[:metadata_path] || ENV["ANDROID_RELEASE_METADATA_PATH"] || File.join(dist_dir, "release-metadata.json")).to_s
    metadata_candidate = make_path_absolute(metadata_path, Dir.pwd)

    if File.exist?(metadata_candidate)
      metadata = JSON.parse(File.read(metadata_candidate))
      metadata_artifact = metadata.fetch("artifactPath", "").to_s.strip
      unless metadata_artifact.empty?
        candidate = make_path_absolute(metadata_artifact, app_root)
        return candidate if File.exist?(candidate)
      end
    end

    aab_candidates = Dir.glob(File.join(dist_dir, "*.aab")).sort_by { |path| File.mtime(path) }.reverse
    if aab_candidates.length == 1
      return aab_candidates.first
    end

    if aab_candidates.length > 1
      UI.user_error!(
        "Multiple AAB artifacts found. Provide artifact_path explicitly (or ANDROID_ARTIFACT_PATH).\n" \
        "Candidates:\n" \
        "#{aab_candidates.map { |path| "- #{path}" }.join("\n")}"
      )
    end

    legacy_candidate = File.join(dist_dir, "app-release.aab")
    return legacy_candidate if File.exist?(legacy_candidate)

    UI.user_error!(
      "Artifact not found. Checked:\n" \
      "- explicit artifact_path/ANDROID_ARTIFACT_PATH\n" \
      "- release metadata artifactPath at #{metadata_candidate}\n" \
      "- AAB files under #{dist_dir}"
    )
  end

  def update_app_versions!(version_name:, version_code:)
    config = load_app_json
    config["expo"] ||= {}
    config["expo"]["android"] ||= {}
    config["expo"]["version"] = version_name
    config["expo"]["android"]["versionCode"] = version_code

    path = resolve_app_json_path
    UI.user_error!("app.json not found") unless path
    File.write(path, "#{JSON.pretty_generate(config)}\n")
  end

  def verify_eas_parity!
    eas_path = File.join(app_root_dir, "eas.json")
    UI.user_error!("Missing required file: #{eas_path}") unless File.exist?(eas_path)

    eas = JSON.parse(File.read(eas_path))
    release_track = eas.dig("submit", "production", "android", "track")
    UI.user_error!("eas.json submit.production.android.track must be 'internal'") unless release_track == "internal"

    auto_increment = eas.dig("build", "production", "autoIncrement")
    UI.user_error!("eas.json build.production.autoIncrement must be true") unless auto_increment == true
  end

  def resolve_release_version_code
    all_codes = []
    (NON_PROD_TRACKS + [PROD_TRACK]).each do |track|
      codes = google_play_track_version_codes(
        package_name: ENV.fetch("ANDROID_APP_PACKAGE"),
        track: track,
        json_key: ENV.fetch("PLAY_JSON_KEY_PATH"),
      )
      all_codes.concat(Array(codes).map(&:to_i))
    rescue StandardError
      next
    end

    floor = ENV.fetch("ANDROID_VERSION_CODE_FLOOR", "0").to_i
    [all_codes.max.to_i, floor].max + 1
  end

  desc "Validate build prerequisites, signing, and EAS parity checks"
  lane :android_preflight_build do
    bootstrap_android_release_env!
    REQUIRED_ENV_BUILD.each { |k| ensure_env!(k) }
    verify_android_google_services_file!

    app_package = app_package_from_config
    expected_package = ensure_env!("ANDROID_APP_PACKAGE")
    UI.user_error!("Package mismatch: app.json=#{app_package}, ANDROID_APP_PACKAGE=#{expected_package}") if app_package != expected_package

    %w[PLAY_JSON_KEY_PATH ANDROID_KEYSTORE_PATH].each do |path_var|
      path = ENV.fetch(path_var)
      UI.user_error!("File not found: #{path_var}=#{path}") unless File.exist?(path)
    end

    verify_eas_parity!
    UI.message("Android preflight validated")
  end

  desc "Validate Play credentials and package consistency"
  lane :android_preflight_play do
    bootstrap_android_release_env!
    REQUIRED_ENV_PLAY.each { |k| ensure_env!(k) }
    verify_android_google_services_file!

    app_package = app_package_from_config
    expected_package = ensure_env!("ANDROID_APP_PACKAGE")
    UI.user_error!("Package mismatch: app.json=#{app_package}, ANDROID_APP_PACKAGE=#{expected_package}") if app_package != expected_package

    play_json = ENV.fetch("PLAY_JSON_KEY_PATH")
    UI.user_error!("File not found: PLAY_JSON_KEY_PATH=#{play_json}") unless File.exist?(play_json)
    UI.message("Android Play preflight validated")
  end

  desc "Apply CI-provided versionName and monotonic versionCode to app.json"
  lane :android_set_versions do |options|
    release_version_name = latest_semver_tag.to_s
    UI.user_error!("No SemVer repository tag found. Run semver tagging workflow before release.") if release_version_name.strip.empty?

    normalized_version_name = release_version_name.sub(/^v/, "")
    UI.user_error!("Latest tag is not SemVer: #{release_version_name}") unless normalized_version_name.match?(/^\d+\.\d+\.\d+$/)
    version_code = resolve_release_version_code

    update_app_versions!(version_name: normalized_version_name, version_code: version_code)

    Actions.lane_context[:RELEASE_VERSION_NAME] = normalized_version_name
    Actions.lane_context[:RELEASE_VERSION_CODE] = version_code
    UI.message("Resolved versionName=#{normalized_version_name} versionCode=#{version_code}")
  end

  desc "Build signed Android release artifact"
  lane :android_build do |options|
    android_preflight_build
    android_set_versions(from_ref: options[:from_ref], to_ref: options[:to_ref])
    app_root = app_root_dir

    Dir.chdir(app_root) do
      sh("CI=1 bunx expo prebuild --platform android --clean")
    end

    gradle_properties_path = File.join(app_root, "android", "gradle.properties")
    gradle_properties = {
      "org.gradle.jvmargs" => "-Xmx4g -XX:MaxMetaspaceSize=1g -Dfile.encoding=UTF-8",
      "org.gradle.daemon" => "false",
      "org.gradle.parallel" => "true",
      "org.gradle.workers.max" => "2",
      "android.lint.parallel" => "false",
      "android.lint.checkReleaseBuilds" => "true",
      "android.lint.abortOnError" => "true",
    }
    File.open(gradle_properties_path, "a") do |f|
      gradle_properties.each { |k, v| f.puts("#{k}=#{v}") }
    end
    UI.message("Updated gradle.properties with build configuration")

    UI.message("Building Android release with signing configuration...")
    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: File.join(app_root, "android"),
      flags: "--no-daemon",
      properties: {
        "android.injected.signing.store.file" => ENV.fetch("ANDROID_KEYSTORE_PATH"),
        "android.injected.signing.store.password" => ENV.fetch("ANDROID_KEYSTORE_PASSWORD"),
        "android.injected.signing.key.alias" => ENV.fetch("ANDROID_KEY_ALIAS"),
        "android.injected.signing.key.password" => ENV.fetch("ANDROID_KEY_PASSWORD"),
      },
      print_command: false,
      print_command_output: true,
    )

    source_artifact = File.join(app_root, "android", "app", "build", "outputs", "bundle", "release", "app-release.aab")
    UI.user_error!("Expected release artifact not found at #{source_artifact}") unless File.exist?(source_artifact)

    dist_dir = File.join(app_root, "dist", "android")
    FileUtils.mkdir_p(dist_dir)
    release_version_name = Actions.lane_context[:RELEASE_VERSION_NAME]
    release_version_code = Actions.lane_context[:RELEASE_VERSION_CODE]
    target_artifact = File.join(dist_dir, "app-#{release_version_name}-#{release_version_code}.aab")
    FileUtils.cp(source_artifact, target_artifact)
    FileUtils.cp(target_artifact, File.join(dist_dir, "app-release.aab"))

    metadata = {
      appPackage: ENV.fetch("ANDROID_APP_PACKAGE"),
      artifactPath: target_artifact,
      artifactSha256: Digest::SHA256.file(target_artifact).hexdigest,
      versionName: release_version_name,
      versionCode: release_version_code,
      sourceTrack: "internal",
      signingLineage: ENV.fetch("ANDROID_SIGNING_LINEAGE"),
      commitSha: sh_capture!("git rev-parse HEAD"),
    }
    File.write(File.join(dist_dir, "release-metadata.json"), JSON.pretty_generate(metadata))

    Actions.lane_context[:RELEASE_ARTIFACT_PATH] = target_artifact
    UI.success("Built artifact: #{target_artifact}")
  end

  desc "Upload artifact to Google Play track"
  lane :android_submit do |options|
    android_preflight_play
    track = (options[:track] || "internal").to_s
    artifact_path = resolve_submit_artifact_path!(options)
    UI.user_error!("Unsupported track for submit: #{track}") unless (NON_PROD_TRACKS + [PROD_TRACK]).include?(track)

    upload_to_play_store(
      track: track,
      aab: artifact_path,
      json_key: ENV.fetch("PLAY_JSON_KEY_PATH"),
      package_name: ENV.fetch("ANDROID_APP_PACKAGE"),
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
    )
  end

  desc "Promote exact version code between tracks with no rebuild"
  lane :android_promote do |options|
    android_preflight_play
    from_track = (options[:from_track] || "internal").to_s
    to_track = options[:to_track].to_s
    version_code = options[:version_code].to_i
    metadata_path = (options[:metadata_path] || "dist/android/release-metadata.json").to_s

    UI.user_error!("Missing to_track") if to_track.empty?
    UI.user_error!("Missing version_code") if version_code <= 0
    UI.user_error!("Release metadata file not found: #{metadata_path}") unless File.exist?(metadata_path)

    release_metadata = JSON.parse(File.read(metadata_path))
    lineage = release_metadata.fetch("signingLineage")
    expected_lineage = ENV.fetch("ANDROID_SIGNING_LINEAGE")
    UI.user_error!("Signing lineage mismatch: metadata=#{lineage} env=#{expected_lineage}") if lineage != expected_lineage

    metadata_version_code = release_metadata.fetch("versionCode").to_i
    UI.user_error!("Metadata versionCode mismatch: metadata=#{metadata_version_code} lane=#{version_code}") if metadata_version_code != version_code

    source_codes = Array(
      google_play_track_version_codes(
        package_name: ENV.fetch("ANDROID_APP_PACKAGE"),
        track: from_track,
        json_key: ENV.fetch("PLAY_JSON_KEY_PATH"),
      ),
    ).map(&:to_i)

    UI.user_error!("Version code #{version_code} not found on #{from_track}") unless source_codes.include?(version_code)

    upload_to_play_store(
      track: from_track,
      track_promote_to: to_track,
      json_key: ENV.fetch("PLAY_JSON_KEY_PATH"),
      package_name: ENV.fetch("ANDROID_APP_PACKAGE"),
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
      changes_not_sent_for_review: false,
    )

    promoted_codes = Array(
      google_play_track_version_codes(
        package_name: ENV.fetch("ANDROID_APP_PACKAGE"),
        track: to_track,
        json_key: ENV.fetch("PLAY_JSON_KEY_PATH"),
      ),
    ).map(&:to_i)

    UI.user_error!("Promotion verification failed: #{version_code} missing on #{to_track}") unless promoted_codes.include?(version_code)
    UI.success("Promoted versionCode=#{version_code} from #{from_track} to #{to_track}")
  end

  desc "Build and upload to internal track"
  lane :android_release do |options|
    android_build(from_ref: options[:from_ref], to_ref: options[:to_ref])
    android_submit(artifact_path: Actions.lane_context[:RELEASE_ARTIFACT_PATH], track: "internal")
  end

  desc "Run local Android CD flow with optional promotions"
  lane :android_local_cd do |options|
    auto_approve = options[:auto_approve].to_s == "true"
    promote_beta = options[:promote_beta].to_s == "true"
    promote_production = options[:promote_production].to_s == "true"
    UI.user_error!("promote_production requires promote_beta") if promote_production && !promote_beta

    current_tag = latest_semver_tag.to_s
    UI.user_error!("No SemVer repository tag found. Create/push tag before local CD.") if current_tag.empty?
    UI.message("Local release uses repository tag #{current_tag}")

    android_release(from_ref: options[:from_ref], to_ref: options[:to_ref])
    metadata = JSON.parse(File.read("dist/android/release-metadata.json"))
    version_code = metadata.fetch("versionCode").to_i

    if promote_beta
      unless auto_approve
        answer = UI.input("Approve promotion internal -> beta? Type 'yes' to continue")
        UI.user_error!("Promotion to beta declined") unless answer.to_s.strip.downcase == "yes"
      end
      android_promote(from_track: "internal", to_track: "beta", version_code: version_code, metadata_path: "dist/android/release-metadata.json")
    end

    if promote_production
      unless auto_approve
        answer = UI.input("Approve promotion beta -> production? Type 'yes' to continue")
        UI.user_error!("Promotion to production declined") unless answer.to_s.strip.downcase == "yes"
      end
      android_promote(from_track: "beta", to_track: "production", version_code: version_code, metadata_path: "dist/android/release-metadata.json")
    end
  end
end

platform :ios do
  REQUIRED_ENV_IOS_BUILD = %w[
    IOS_DIST_CERT_PATH
    IOS_PROFILE_PATH
    IOS_DIST_CERT_PASSWORD
    IOS_BUNDLE_IDENTIFIER
  ].freeze

  REQUIRED_ENV_IOS_SUBMIT = %w[
    IOS_ASC_KEY_ID
    IOS_ASC_ISSUER_ID
    IOS_ASC_KEY_PATH
    IOS_BUNDLE_IDENTIFIER
  ].freeze

  IOS_DESTINATIONS = %w[testflight_internal testflight_external app_store].freeze

  def ios_ensure_env!(key)
    value = ENV[key].to_s.strip
    UI.user_error!("Missing required environment variable: #{key}") if value.empty?
    if key.end_with?("_PATH")
      absolute = make_path_absolute(value, Dir.pwd)
      UI.user_error!("File not found for #{key}: #{absolute}") unless File.exist?(absolute)
      return absolute
    end
    value
  end

  def ios_bundle_id_from_config
    load_app_json.dig("expo", "ios", "bundleIdentifier").to_s.strip
  end

  def ios_run_if_script_defined!(script_name, app_root)
    package_json_path = File.join(app_root, "package.json")
    return unless File.exist?(package_json_path)

    scripts = JSON.parse(File.read(package_json_path)).fetch("scripts", {})
    return unless scripts.key?(script_name)

    Dir.chdir(app_root) do
      UI.message("Running lifecycle hook: #{script_name}")
      sh("bun run #{script_name}")
    end
  end

  def ios_profile_metadata(profile_path)
    xml = sh_capture!("security cms -D -i #{Shellwords.escape(profile_path)}")
    uuid = xml[/<key>UUID<\/key>\s*<string>([^<]+)<\/string>/, 1].to_s.strip
    app_identifier = xml[/<key>application-identifier<\/key>\s*<string>([^<]+)<\/string>/, 1].to_s.strip
    team_identifier = xml[/<key>TeamIdentifier<\/key>\s*<array>\s*<string>([^<]+)<\/string>/m, 1].to_s.strip
    {
      uuid: uuid,
      application_identifier: app_identifier,
      team_identifier: team_identifier,
    }
  end

  def ios_profile_supports_bundle_id?(profile_app_identifier, bundle_id)
    return false if profile_app_identifier.to_s.strip.empty? || bundle_id.to_s.strip.empty?

    _team, suffix = profile_app_identifier.split(".", 2)
    return false if suffix.to_s.strip.empty?
    return true if suffix == "*"

    if suffix.end_with?("*")
      prefix = suffix.delete_suffix("*")
      return bundle_id.start_with?(prefix)
    end

    suffix == bundle_id
  end

  def ios_prepare_signing_material!
    cert_path = ios_ensure_env!("IOS_DIST_CERT_PATH")
    profile_path = ios_ensure_env!("IOS_PROFILE_PATH")
    cert_password = ios_ensure_env!("IOS_DIST_CERT_PASSWORD")

    UI.message("Validating distribution certificate...")
    # Use sh_silent to avoid logging the password in the command
    sh_silent("openssl pkcs12 -in #{Shellwords.escape(cert_path)} -nokeys -passin pass:#{Shellwords.escape(cert_password)} >/dev/null 2>&1")

    keychain_name = ENV.fetch("IOS_KEYCHAIN_NAME", "fastlane_ios_release_#{SecureRandom.hex(4)}")
    keychain_password = ENV.fetch("IOS_KEYCHAIN_PASSWORD", SecureRandom.hex(24))

    UI.message("Creating temporary keychain: #{keychain_name}")
    create_keychain(
      name: keychain_name,
      password: keychain_password,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: true,
      add_to_search_list: true,
      default_keychain: true,
    )

    UI.message("Importing distribution certificate...")
    import_certificate(
      certificate_path: cert_path,
      certificate_password: cert_password,
      keychain_name: keychain_name,
      keychain_password: keychain_password,
    )

    provisioning_dir = File.expand_path("~/Library/MobileDevice/Provisioning Profiles")
    FileUtils.mkdir_p(provisioning_dir)
    profile_metadata = ios_profile_metadata(profile_path)
    profile_uuid = profile_metadata.fetch(:uuid)
    UI.user_error!("Unable to parse provisioning profile UUID: #{profile_path}") if profile_uuid.empty?

    installed_profile_path = File.join(provisioning_dir, "#{profile_uuid}.mobileprovision")
    FileUtils.cp(profile_path, installed_profile_path)

    # Store context values - password is stored but sanitized from logs
    Actions.lane_context[:IOS_KEYCHAIN_NAME] = keychain_name
    Actions.lane_context[:IOS_KEYCHAIN_PASSWORD] = keychain_password
    Actions.lane_context[:IOS_PROFILE_UUID] = profile_uuid
    Actions.lane_context[:IOS_INSTALLED_PROFILE_PATH] = installed_profile_path
    Actions.lane_context[:IOS_PROFILE_APP_IDENTIFIER] = profile_metadata.fetch(:application_identifier)
    Actions.lane_context[:IOS_PROFILE_TEAM_IDENTIFIER] = profile_metadata.fetch(:team_identifier)

    # Mark sensitive data in lane context
    sanitize_lane_context!
  end

  def ios_apply_profile_to_project!(xcode_target)
    project_path = xcode_target[:project]
    if project_path.to_s.strip.empty? && xcode_target[:workspace]
      workspace_base = File.basename(xcode_target[:workspace], ".xcworkspace")
      candidate = File.join(File.dirname(xcode_target[:workspace]), "#{workspace_base}.xcodeproj")
      project_path = candidate if File.exist?(candidate)
    end

    UI.user_error!("Unable to resolve .xcodeproj for provisioning profile update") if project_path.to_s.strip.empty?

    profile_path = Actions.lane_context[:IOS_INSTALLED_PROFILE_PATH].to_s
    if profile_path.empty?
      profile_uuid = Actions.lane_context[:IOS_PROFILE_UUID].to_s
      profile_path = File.expand_path("~/Library/MobileDevice/Provisioning Profiles/#{profile_uuid}.mobileprovision") unless profile_uuid.empty?
    end
    UI.user_error!("Provisioning profile not found for project update: #{profile_path}") unless File.exist?(profile_path)

    build_configuration = ENV.fetch("IOS_BUILD_CONFIGURATION", "Release")
    UI.message("Applying provisioning profile to Xcode project (#{build_configuration})")
    update_project_provisioning(
      xcodeproj: project_path,
      profile: profile_path,
      target_filter: ".*",
      build_configuration: build_configuration,
      code_signing_identity: ENV.fetch("IOS_CODE_SIGNING_IDENTITY", "Apple Distribution"),
    )
  end

  def ios_cleanup_signing_material!
    keychain_name = Actions.lane_context[:IOS_KEYCHAIN_NAME].to_s
    return if keychain_name.empty?

    UI.message("Cleaning up temporary keychain: #{keychain_name}")
    delete_keychain(name: keychain_name)

    # Clear sensitive data from lane context
    Actions.lane_context.delete(:IOS_KEYCHAIN_PASSWORD)
    Actions.lane_context.delete(:IOS_KEYCHAIN_NAME)
    Actions.lane_context.delete(:IOS_INSTALLED_PROFILE_PATH)
  rescue StandardError => e
    UI.important("Could not delete temporary keychain #{keychain_name}: #{e.message}")
  end

  def ios_resolve_xcode_project(app_root)
    ios_dir = File.join(app_root, "ios")
    workspace = Dir.glob(File.join(ios_dir, "*.xcworkspace")).first
    project = Dir.glob(File.join(ios_dir, "*.xcodeproj")).first

    if workspace
      scheme = ENV["IOS_SCHEME"].to_s.strip
      if scheme.empty?
        base = File.basename(workspace, ".xcworkspace")
        candidate = File.join(ios_dir, "#{base}.xcodeproj")
        scheme = base if File.exist?(candidate)
      end
      UI.user_error!("Unable to resolve IOS_SCHEME for workspace #{workspace}") if scheme.to_s.strip.empty?
      return { workspace: workspace, scheme: scheme }
    end

    if project
      scheme = ENV["IOS_SCHEME"].to_s.strip
      if scheme.empty?
        scheme = File.basename(project, ".xcodeproj")
      end
      return { project: project, scheme: scheme }
    end

    UI.user_error!("Unable to resolve iOS workspace/project under #{ios_dir}")
  end

  def ios_release_classification!(options)
    classification = (options[:release_classification] || ENV["IOS_RELEASE_CLASSIFICATION"] || "patch").to_s.strip
    UI.user_error!("Unsupported iOS release classification: #{classification}") unless %w[patch minor major].include?(classification)
    classification
  end

  def ios_destination_for_classification(classification)
    case classification
    when "patch", "minor", "major"
      "testflight_internal"
    else
      UI.user_error!("Unsupported release classification: #{classification}")
    end
  end

  def ios_external_destination_for_classification(classification)
    case classification
    when "minor", "major"
      "testflight_external"
    when "patch"
      nil
    else
      UI.user_error!("Unsupported release classification: #{classification}")
    end
  end

  def ios_production_destination_for_classification(classification)
    case classification
    when "major"
      "app_store"
    when "patch", "minor"
      nil
    else
      UI.user_error!("Unsupported release classification: #{classification}")
    end
  end

  def ios_resolve_archive_path!(options)
    explicit_artifact = (options[:artifact_path] || ENV["IOS_ARTIFACT_PATH"]).to_s.strip
    unless explicit_artifact.empty?
      candidate = make_path_absolute(explicit_artifact, Dir.pwd)
      UI.user_error!("iOS artifact not found: #{candidate}") unless File.exist?(candidate)
      return candidate
    end

    app_root = app_root_dir
    metadata_path = (options[:metadata_path] || ENV["IOS_RELEASE_METADATA_PATH"] || File.join(app_root, "dist", "ios", "release-metadata.json")).to_s
    metadata_candidate = make_path_absolute(metadata_path, Dir.pwd)
    if File.exist?(metadata_candidate)
      metadata = JSON.parse(File.read(metadata_candidate))
      metadata_artifact = metadata.fetch("artifactPath", "").to_s.strip
      unless metadata_artifact.empty?
        candidate = make_path_absolute(metadata_artifact, app_root)
        return candidate if File.exist?(candidate)
      end
    end

    application_archive_path = (options[:application_archive_path] || ENV["IOS_APPLICATION_ARCHIVE_PATH"] || "dist/ios/*.ipa").to_s
    glob_pattern = make_path_absolute(application_archive_path, app_root)
    candidates = Dir.glob(glob_pattern).sort_by { |path| File.mtime(path) }.reverse

    return candidates.first if candidates.length == 1

    if candidates.length > 1
      UI.user_error!(
        "Multiple iOS artifacts matched #{glob_pattern}. Provide artifact_path explicitly.\n" \
        "Candidates:\n#{candidates.map { |path| "- #{path}" }.join("\n")}"
      )
    end

    UI.user_error!(
      "iOS artifact not found. Checked:\n" \
      "- explicit artifact_path/IOS_ARTIFACT_PATH\n" \
      "- release metadata artifactPath at #{metadata_candidate}\n" \
      "- applicationArchivePath glob #{glob_pattern}"
    )
  end

  def ios_app_store_connect_api_key!
    key_id = ios_ensure_env!("IOS_ASC_KEY_ID")
    issuer_id = ios_ensure_env!("IOS_ASC_ISSUER_ID")
    key_path = ios_ensure_env!("IOS_ASC_KEY_PATH")

    UI.message("Creating App Store Connect API key (key_id: #{key_id})")
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      duration: 1200,
      in_house: false,
    )
  end

  def ios_verify_eas_parity!
    eas_path = File.join(app_root_dir, "eas.json")
    UI.user_error!("Missing required file: #{eas_path}") unless File.exist?(eas_path)

    eas = JSON.parse(File.read(eas_path))
    asc_app_id = eas.dig("submit", "production", "ios", "ascAppId").to_s.strip
    UI.user_error!("eas.json submit.production.ios.ascAppId is required") if asc_app_id.empty?
  end

  desc "Validate iOS build prerequisites, signing material, and EAS parity checks"
  lane :ios_preflight_build do
    bootstrap_ios_release_env!
    REQUIRED_ENV_IOS_BUILD.each { |k| ios_ensure_env!(k) }

    bundle_id_from_config = ios_bundle_id_from_config
    bundle_id_from_env = ios_ensure_env!("IOS_BUNDLE_IDENTIFIER")
    UI.user_error!("iOS bundle ID mismatch: app.json=#{bundle_id_from_config} IOS_BUNDLE_IDENTIFIER=#{bundle_id_from_env}") if bundle_id_from_config != bundle_id_from_env

    sh("xcodebuild -version")
    sh("ruby --version")
    sh("node --version")
    sh("bun --version")

    cert_path = ios_ensure_env!("IOS_DIST_CERT_PATH")
    profile_path = ios_ensure_env!("IOS_PROFILE_PATH")
    cert_password = ios_ensure_env!("IOS_DIST_CERT_PASSWORD")

    UI.message("Validating distribution certificate at #{cert_path}")
    # Use sh_silent to avoid logging the password in the command
    sh_silent("openssl pkcs12 -in #{Shellwords.escape(cert_path)} -nokeys -passin pass:#{Shellwords.escape(cert_password)} >/dev/null 2>&1")

    profile = ios_profile_metadata(profile_path)
    profile_identifier = profile.fetch(:application_identifier)
    unless ios_profile_supports_bundle_id?(profile_identifier, bundle_id_from_env)
      UI.user_error!("Provisioning profile application-identifier #{profile_identifier} is incompatible with bundle identifier #{bundle_id_from_env}")
    end

    ios_verify_eas_parity!
    UI.message("iOS preflight validated for bundle ID #{bundle_id_from_env}")
  end

  desc "Validate iOS submit prerequisites and App Store Connect credentials"
  lane :ios_preflight_submit do
    bootstrap_ios_release_env!
    REQUIRED_ENV_IOS_SUBMIT.each { |k| ios_ensure_env!(k) }
    ios_preflight_build
    ios_app_store_connect_api_key!
    UI.message("iOS submit preflight validated")
  end

  desc "Build signed iOS release artifact with EAS-aligned lifecycle ordering"
  lane :ios_build do |options|
    ios_preflight_build
    app_root = app_root_dir
    classification = ios_release_classification!(options)
    destination = ios_destination_for_classification(classification)

    ios_run_if_script_defined!("eas-build-pre-install", app_root)

    repo_root = File.expand_path("../..", app_root)
    Dir.chdir(repo_root) do
      Bundler.unbundled_system("bun install --frozen-lockfile")
    end

    Dir.chdir(app_root) do
      Bundler.unbundled_system("CI=1 bunx expo prebuild --platform ios --clean")
    end

    ios_prepare_signing_material!

    begin
      ios_dir = File.join(app_root, "ios")
      Dir.chdir(ios_dir) do
        UI.message("Installing CocoaPods dependencies...")
        Bundler.unbundled_system("pod install")
      end

      ios_run_if_script_defined!("eas-build-post-install", app_root)

      xcode_target = ios_resolve_xcode_project(app_root)
      ios_apply_profile_to_project!(xcode_target)
      output_dir = File.join(app_root, "dist", "ios")
      FileUtils.mkdir_p(output_dir)

      version_name = latest_semver_tag.to_s.sub(/^v/, "")
      version_name = app_version_name.to_s if version_name.empty?
      output_name = "app-#{version_name}.ipa"

      UI.message("Building iOS archive with Gym...")

      # Get keychain path and provisioning profile info from lane context
      keychain_name = Actions.lane_context[:IOS_KEYCHAIN_NAME]
      keychain_path = sh_capture!("security list-keychains | grep '#{keychain_name}' | tr -d '\"' | xargs").strip
      profile_uuid = Actions.lane_context[:IOS_PROFILE_UUID]
      team_identifier = Actions.lane_context[:IOS_PROFILE_TEAM_IDENTIFIER].to_s
      bundle_identifier = ios_ensure_env!("IOS_BUNDLE_IDENTIFIER")
      UI.user_error!("Missing team identifier from provisioning profile metadata") if team_identifier.empty?
      archive_code_sign_identity = ENV.fetch("IOS_ARCHIVE_CODE_SIGN_IDENTITY", "Apple Distribution")
      archive_xcargs = [
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY=#{Shellwords.escape(archive_code_sign_identity)}",
        "DEVELOPMENT_TEAM=#{team_identifier}",
      ].join(" ")

      gym_options = {
        scheme: xcode_target.fetch(:scheme),
        clean: true,
        suppress_xcode_output: true,
        xcodebuild_formatter: '',
        silent: false,
        xcargs: archive_xcargs,
        export_method: (ENV["IOS_EXPORT_METHOD"].to_s.strip.empty? ? "app-store" : ENV["IOS_EXPORT_METHOD"]),
        output_directory: output_dir,
        output_name: output_name,
        export_options: {
          method: (ENV["IOS_EXPORT_METHOD"].to_s.strip.empty? ? "app-store" : ENV["IOS_EXPORT_METHOD"]),
          provisioningProfiles: {
            bundle_identifier => profile_uuid
          }
        },
        export_xcargs: "OTHER_CODE_SIGN_FLAGS=\"--keychain #{keychain_path}\"",
      }
      gym_options[:workspace] = xcode_target[:workspace] if xcode_target[:workspace]
      gym_options[:project] = xcode_target[:project] if xcode_target[:project]

      gym(gym_options)

      artifact_path = ios_resolve_archive_path!(
        artifact_path: File.join(output_dir, output_name),
        application_archive_path: ENV["IOS_APPLICATION_ARCHIVE_PATH"],
      )

      metadata = {
        artifactPath: artifact_path,
        artifactSha256: Digest::SHA256.file(artifact_path).hexdigest,
        bundleIdentifier: ios_ensure_env!("IOS_BUNDLE_IDENTIFIER"),
        releaseClassification: classification,
        releaseDestination: destination,
        profileUuid: Actions.lane_context[:IOS_PROFILE_UUID],
        commitSha: sh_capture!("git rev-parse HEAD"),
      }

      metadata_path = File.join(output_dir, "release-metadata.json")
      File.write(metadata_path, JSON.pretty_generate(metadata))
      Actions.lane_context[:IOS_RELEASE_ARTIFACT_PATH] = artifact_path
      Actions.lane_context[:IOS_RELEASE_METADATA_PATH] = metadata_path

      ios_run_if_script_defined!("eas-build-on-success", app_root)
      UI.success("Built iOS artifact: #{artifact_path}")
      UI.message("Resolved release classification=#{classification} destination=#{destination}")
    rescue StandardError => e
      ios_run_if_script_defined!("eas-build-on-error", app_root)
      raise e
    ensure
      ios_run_if_script_defined!("eas-build-on-complete", app_root)
      ios_cleanup_signing_material!
    end
  end

  desc "Submit iOS release artifact based on SemVer routing"
  lane :ios_submit do |options|
    ios_preflight_submit

    classification = ios_release_classification!(options)
    destination = (options[:destination] || ENV["IOS_RELEASE_DESTINATION"] || ios_destination_for_classification(classification)).to_s
    UI.user_error!("Unsupported iOS destination: #{destination}") unless IOS_DESTINATIONS.include?(destination)

    artifact_path = ios_resolve_archive_path!(options)
    api_key = ios_app_store_connect_api_key!

    UI.message("Submitting iOS release classification=#{classification} destination=#{destination} artifact=#{artifact_path}")

    case destination
    when "testflight_internal"
      upload_to_testflight(
        ipa: artifact_path,
        api_key: api_key,
        skip_waiting_for_build_processing: true,
        distribute_external: false,
        changelog: ENV["IOS_RELEASE_CHANGELOG"].to_s,
      )
    when "testflight_external"
      groups = ENV.fetch("IOS_TESTFLIGHT_EXTERNAL_GROUPS", "").split(",").map(&:strip).reject(&:empty?)
      upload_to_testflight(
        ipa: artifact_path,
        api_key: api_key,
        skip_waiting_for_build_processing: true,
        distribute_external: true,
        groups: groups,
        changelog: ENV["IOS_RELEASE_CHANGELOG"].to_s,
      )
    when "app_store"
      upload_to_app_store(
        ipa: artifact_path,
        api_key: api_key,
        skip_metadata: true,
        skip_screenshots: true,
        skip_app_version_update: true,
        force: true,
        submit_for_review: false,
        automatic_release: false,
      )
    end
  end

  desc "Build and submit iOS release with SemVer-based routing"
  lane :ios_release do |options|
    classification = ios_release_classification!(options)
    destination = ios_destination_for_classification(classification)
    UI.message("iOS release routing -> classification=#{classification} destination=#{destination}")

    ios_build(release_classification: classification)
    ios_submit(
      artifact_path: Actions.lane_context[:IOS_RELEASE_ARTIFACT_PATH],
      metadata_path: Actions.lane_context[:IOS_RELEASE_METADATA_PATH],
      release_classification: classification,
      destination: destination,
    )
  end

  private_lane :bootstrap_ios_release_env! do
    credentials_path = resolve_credentials_path
    credentials = {}
    credentials_dir = File.dirname(File.expand_path(credentials_path))

    if File.exist?(credentials_path)
      credentials = JSON.parse(File.read(credentials_path))
    end

    ios_credentials = credentials.fetch("ios", {})
    distribution_certificate = ios_credentials.fetch("distributionCertificate", {})
    provisioning_profile_path = ios_credentials.fetch("provisioningProfilePath", "").to_s.strip

    cert_path = distribution_certificate.fetch("path", "").to_s.strip
    cert_password = distribution_certificate.fetch("password", "").to_s.strip

    if ENV["IOS_DIST_CERT_PATH"].to_s.strip.empty? && !cert_path.empty?
      ENV["IOS_DIST_CERT_PATH"] = make_path_absolute(cert_path, credentials_dir)
    end

    if ENV["IOS_PROFILE_PATH"].to_s.strip.empty? && !provisioning_profile_path.empty?
      ENV["IOS_PROFILE_PATH"] = make_path_absolute(provisioning_profile_path, credentials_dir)
    end

    if ENV["IOS_DIST_CERT_PASSWORD"].to_s.strip.empty? && !cert_password.empty?
      ENV["IOS_DIST_CERT_PASSWORD"] = cert_password
    end

    if ENV["IOS_BUNDLE_IDENTIFIER"].to_s.strip.empty?
      bundle_id = ios_bundle_id_from_config
      ENV["IOS_BUNDLE_IDENTIFIER"] = bundle_id unless bundle_id.empty?
    end
  end
end
