{
  "name": "@mirai-app/native",
  "version": "1.0.0",
  "main": "index.ts",
  "type": "module",
  "license": "AGPL-3.0",
  "private": true,
  "scripts": {
    "predev": "bun ./scripts/patch-node-modules.js",
    "dev": "bunx expo start",
    "env:dev": "EXPO_ENVIRONMENT=development",
    "start": "bunx expo start",
    "android": "bunx expo run:android",
    "ios": "bunx expo run:ios",
    "web": "bunx expo start --web",
    "build": "bunx expo export",
    "release:android:preflight": "bundle exec fastlane android android_preflight_build",
    "release:android:build": "bundle exec fastlane android android_build",
    "release:android:submit": "bundle exec fastlane android android_submit",
    "release:android:release": "bundle exec fastlane android android_release",
    "release:android:promote": "bundle exec fastlane android android_promote",
    "release:android:local-cd": "bundle exec fastlane android android_local_cd",
    "release:ios:preflight": "bundle exec fastlane ios ios_preflight_build",
    "release:ios:build": "bundle exec fastlane ios ios_build",
    "release:ios:submit": "bundle exec fastlane ios ios_submit",
    "release:ios:release": "bundle exec fastlane ios ios_release",
    "postinstall": "bun ./scripts/patch-node-modules.js",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx}\" --cache",
    "clean": "rm -rf .expo .turbo node_modules dist",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo/metro-runtime": "^6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@maplibre/maplibre-react-native": "^10.4.2",
    "@mirai-app/auth": "workspace:*",
    "@mirai-app/shared": "workspace:*",
    "@mirai-app/supabase": "workspace:*",
    "@mirai-app/trpc": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/query-core": "^5.90.20",
    "@tanstack/react-query": "^5.90.19",
    "expo": "~54.0.33",
    "expo-asset": "^12.0.12",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "^17.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "^15.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "^14.0.11",
    "expo-image": "^3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "^17.0.10",
    "expo-linear-gradient": "^15.0.8",
    "expo-linking": "~8.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "^0.32.16",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "^14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-updates": "~29.0.16",
    "expo-video": "~3.0.16",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css-interop": "^0.2.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-pdf": "^7.0.3",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.19",
    "tus-js-client": "^4.3.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/react": "~19.1.17",
    "@types/react-dom": "~19.1.11",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.8.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3"
  }
}
