{
  "name": "@integral-2025-app/native",
  "version": "1.0.0",
  "main": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx}\" --cache",
    "test": "jest -coverage",
    "test:ci": "jest --silent --no-coverage",
    "clean": "rm -rf .expo .turbo node_modules dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.0",
    "@integral-2025-app/auth": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@supabase/supabase-js": "^2.80.0",
    "@tamagui/babel-plugin": "^1.138.0",
    "@tamagui/config": "^1.138.1",
    "@tamagui/lucide-icons": "^1.138.1",
    "expo": "~54.0.25",
    "expo-constants": "~17.0.8",
    "expo-router": "^6.0.15",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~3.0.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-native": "0.82.1",
    "react-native-web": "^0.21.2",
    "tamagui": "^1.138.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@integral-2025-app/jest-config": "workspace:*",
    "@jest/globals": "^30.2.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "babel-jest": "^30.2.0",
    "eslint": "^9.23.0",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.13",
    "prettier": "^3.5.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.27.0"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@integral-2025-app/auth$": "<rootDir>/../../packages/auth/src"
    }
  }
}
