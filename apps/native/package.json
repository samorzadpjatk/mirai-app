{
  "name": "@integral-2025-app/native",
  "version": "1.0.0",
  "main": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx}\" --cache",
    "test": "jest -coverage",
    "test:ci": "jest --silent --no-coverage",
    "clean": "rm -rf .expo .turbo node_modules dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "^6.1.2",
    "@integral-2025-app/auth": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.86.2",
    "@tamagui/babel-plugin": "^1.138.6",
    "@tamagui/config": "^1.139.1",
    "@tamagui/lucide-icons": "^1.138.6",
    "expo": "^54.0.27",
    "expo-constants": "^18.0.11",
    "expo-router": "^6.0.17",
    "expo-secure-store": "^15.0.8",
    "expo-status-bar": "^3.0.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "^0.82.1",
    "react-native-web": "^0.21.2",
    "tamagui": "^1.138.6"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@integral-2025-app/jest-config": "workspace:*",
    "@jest/globals": "^29.7.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.7",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.1",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.14",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@integral-2025-app/auth$": "<rootDir>/../../packages/auth/src"
    }
  }
}
