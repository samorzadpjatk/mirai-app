{
  "name": "@integral-2025-app/native",
  "version": "1.0.0",
  "main": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx}\" --cache",
    "test": "jest -coverage",
    "test:ci": "jest --silent --no-coverage",
    "clean": "rm -rf .expo .turbo node_modules dist"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo/metro-runtime": "^6.1.2",
    "@integral-2025-app/auth": "workspace:*",
    "@integral-2025-app/supabase": "workspace:*",
    "@integral-2025-app/trpc": "workspace:*",
    "@maplibre/maplibre-react-native": "^10.4.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.89.0",
    "@tamagui/babel-plugin": "1.141.5",
    "@tamagui/colors": "1.141.5",
    "@tamagui/config": "1.141.5",
    "@tamagui/lucide-icons": "1.141.5",
    "@tamagui/theme-builder": "1.141.5",
    "@tanstack/react-query": "^5.90.16",
    "@trpc/client": "^11.8.1",
    "expo": "^54.0.30",
    "expo-asset": "^12.0.12",
    "expo-constants": "^18.0.12",
    "expo-font": "^14.0.10",
    "expo-image": "^3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-router": "^6.0.21",
    "expo-secure-store": "^15.0.8",
    "expo-status-bar": "^3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.6",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.7.1",
    "superjson": "^2.2.6",
    "tamagui": "1.141.5"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@integral-2025-app/jest-config": "workspace:*",
    "@jest/globals": "^29.7.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.17",
    "@types/react-dom": "~19.1.11",
    "babel-jest": "^29.7.0",
    "babel-plugin-transform-remove-imports": "^1.8.1",
    "eslint": "^9.39.2",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.16",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@integral-2025-app/auth$": "<rootDir>/../../packages/auth/src",
      "^@integral-2025-app/trpc$": "<rootDir>/../../packages/trpc/src"
    }
  }
}
