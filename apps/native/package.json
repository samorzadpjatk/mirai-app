{
  "name": "@integral-2025-app/native",
  "version": "1.0.0",
  "main": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "bun ./scripts/patch-node-modules.js",
    "dev": "bunx expo start",
    "start": "bunx expo start",
    "android": "bunx expo run:android",
    "ios": "bunx expo run:ios",
    "web": "bunx expo start --web",
    "build": "bunx expo export",
    "postinstall": "bun ./scripts/patch-node-modules.js",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx}\" --cache",
    "test": "jest --coverage",
    "test:ci": "jest --silent --no-coverage",
    "clean": "rm -rf .expo .turbo node_modules dist"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo/metro-runtime": "^6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@integral-2025-app/auth": "workspace:*",
    "@integral-2025-app/supabase": "workspace:*",
    "@integral-2025-app/trpc": "workspace:*",
    "@maplibre/maplibre-react-native": "^10.4.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-picker/picker": "2.11.1",
    "@tanstack/react-query": "^5.90.19",
    "expo": "~54.0.33",
    "expo-asset": "^12.0.12",
    "expo-camera": "^17.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "^15.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "^14.0.11",
    "expo-image": "^3.0.11",
    "expo-image-picker": "^17.0.10",
    "expo-linear-gradient": "^15.0.8",
    "expo-linking": "~8.0.11",
    "expo-notifications": "^0.32.16",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "^14.0.8",
    "expo-status-bar": "~3.0.9",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css-interop": "^0.2.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-pdf": "^7.0.3",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.19",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.17",
    "@types/react-dom": "~19.1.11",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "prettier": "^3.8.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@integral-2025-app/auth$": "<rootDir>/../../packages/auth/src",
      "^@integral-2025-app/trpc$": "<rootDir>/../../packages/trpc/src"
    }
  }
}
