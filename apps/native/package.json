{
  "name": "@mirai-app/native",
  "version": "1.0.0",
  "main": "index.ts",
  "type": "module",
  "license": "AGPL-3.0",
  "private": true,
  "scripts": {
    "dev": "bunx expo start",
    "env:dev": "EXPO_ENVIRONMENT=development",
    "start": "bunx expo start",
    "android": "bunx expo run:android",
    "ios": "bunx expo run:ios",
    "web": "bunx expo start --web",
    "build": "bunx expo export",
    "release:android:preflight": "bundle exec fastlane android android_preflight_build",
    "release:android:build": "bundle exec fastlane android android_build",
    "release:android:submit": "bundle exec fastlane android android_submit",
    "release:android:release": "bundle exec fastlane android android_release",
    "release:android:promote": "bundle exec fastlane android android_promote",
    "release:android:local-cd": "bundle exec fastlane android android_local_cd",
    "release:ios:preflight": "bundle exec fastlane ios ios_preflight_build",
    "release:ios:build": "bundle exec fastlane ios ios_build",
    "release:ios:submit": "bundle exec fastlane ios ios_submit",
    "release:ios:release": "bundle exec fastlane ios ios_release",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "format:check": "oxfmt --check '**/*.{ts,tsx,js,jsx}'",
    "format:write": "oxfmt '**/*.{ts,tsx,js,jsx}'",
    "test": "jest --coverage",
    "test:ci": "jest --passWithNoTests --ci --coverage",
    "test:watch": "jest --watch",
    "clean": "rm -rf .expo .turbo node_modules dist coverage"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo/metro-runtime": "~55.0.11",
    "@expo/vector-icons": "^15.0.3",
    "@maplibre/maplibre-react-native": "^10.4.2",
    "@mirai-app/auth": "workspace:*",
    "@mirai-app/shared": "workspace:*",
    "@mirai-app/supabase": "workspace:*",
    "@mirai-app/orpc": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/query-core": "^5.90.20",
    "@tanstack/react-query": "^5.90.19",
    "expo": "^55.0.0",
    "expo-asset": "~55.0.17",
    "expo-build-properties": "~55.0.13",
    "expo-camera": "~55.0.18",
    "expo-constants": "~55.0.16",
    "expo-crypto": "~55.0.14",
    "expo-file-system": "~55.0.19",
    "expo-font": "~55.0.7",
    "expo-image": "~55.0.10",
    "expo-image-manipulator": "~55.0.16",
    "expo-image-picker": "~55.0.20",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.15",
    "expo-location": "~55.1.9",
    "expo-notifications": "~55.0.22",
    "expo-router": "~55.0.14",
    "expo-secure-store": "~55.0.13",
    "expo-sharing": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "expo-task-manager": "~55.0.15",
    "expo-updates": "~55.0.21",
    "expo-video": "~55.0.16",
    "nativewind": "^4.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-css-interop": "^0.2.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-pdf": "^7.0.3",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "tailwindcss": "^3.4.19",
    "tus-js-client": "^4.3.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "^7.28.6",
    "@babel/preset-env": "^7.29.3",
    "@babel/preset-flow": "^7.25.4",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@jest/globals": "^30.3.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.17",
    "prettier": "^3.8.0",
    "react-test-renderer": "19.2.0",
    "superjson": "^2.2.6",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3"
  }
}
