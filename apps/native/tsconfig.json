{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "jsx": "react-native",
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"],
      "@integral-2025-app/auth": ["../../packages/auth/src/index.ts"],
      "@integral-2025-app/auth/*": ["../../packages/auth/src/*"],
      "@integral-2025-app/common-types": ["../../packages/common-types/src/index.ts"],
      "@integral-2025-app/common-types/*": ["../../packages/common-types/src/*"],
      "@integral-2025-app/db": ["../../packages/db/src/index.ts"],
      "@integral-2025-app/db/*": ["../../packages/db/src/*"],
      "@integral-2025-app/supabase": ["../../packages/supabase/src/index.ts"],
      "@integral-2025-app/supabase/*": ["../../packages/supabase/src/*"],
      "@integral-2025-app/trpc": ["../../packages/trpc/src/index.ts"],
      "@integral-2025-app/trpc/*": ["../../packages/trpc/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
