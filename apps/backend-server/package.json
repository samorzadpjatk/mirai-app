{
  "name": "@mirai-app/backend-server",
  "version": "1.0.0",
  "description": "Mirai App Backend Server - GraphQL API on Bun",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "check": "eslint . && tsc --noEmit",
    "clean": "rm -rf node_modules",
    "dev": "bun --watch src/server-bootstrap.ts",
    "generate:sdl": "bun src/graphql/schema.ts",
    "start": "bun src/server-bootstrap.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:bun && bun run test:yoga && bun run test:rest",
    "test:bun": "bun test src/__tests__/bun-server*.test.ts src/__tests__/server-config.test.ts",
    "test:yoga": "bun test src/graphql/__tests__/yoga.integration.test.ts",
    "test:rest": "bun test --exclude src/graphql/__tests__/yoga.integration.test.ts --exclude src/__tests__/bun-server*.test.ts --exclude src/__tests__/server-config.test.ts",
    "test:unit": "bun run test",
    "test:coverage": "bun test --coverage"
  },
  "keywords": [
    "graphql",
    "bun",
    "api"
  ],
  "private": true,
  "license": "AGPL-3.0",
  "dependencies": {
    "@mirai-app/adapters": "workspace:*",
    "@mirai-app/frameworks": "workspace:*",
    "@mirai-app/use-cases": "workspace:*",
    "@mirai-app/domain": "workspace:*",
    "@pothos/core": "^4.12.0",
    "effect": "^3.14.0",
    "@pothos/plugin-scope-auth": "^4.1.6",
    "@pothos/plugin-dataloader": "^4.4.3",
    "@pothos/plugin-relay": "^4.4.0",
    "graphql": "^16.10.0",
    "graphql-scalars": "^1.24.2",
    "graphql-yoga": "^5.13.4",
    "hono": "^4.7.5"
  },
  "devDependencies": {
    "@types/bun":"^1.3.12",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.16",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
