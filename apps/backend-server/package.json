{
  "name": "@mirai-app/backend-server",
  "version": "1.0.0",
  "description": "Mirai App Backend Server - GraphQL API on Hono",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "check": "eslint . && tsc --noEmit",
    "clean": "rm -rf node_modules",
    "dev": "bun --watch src/index-hono.ts",
    "generate:sdl": "bun src/graphql/schema.ts",
    "start": "bun src/index-hono.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "keywords": [
    "graphql",
    "hono",
    "api"
  ],
  "private": true,
  "license": "AGPL-3.0",
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@mirai-app/adapters": "workspace:*",
    "@mirai-app/frameworks": "workspace:*",
    "@mirai-app/use-cases": "workspace:*",
    "@mirai-app/domain": "workspace:*",
    "@pothos/core": "^4.12.0",
    "effect": "^3.14.0",
    "@pothos/plugin-scope-auth": "^4.1.6",
    "@pothos/plugin-dataloader": "^4.4.3",
    "@pothos/plugin-relay": "^4.4.0",
    "awilix": "^12.0.0",
    "graphql": "^16.10.0",
    "graphql-scalars": "^1.24.2",
    "graphql-yoga": "^5.13.4",
    "hono": "^4.7.5"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@vitest/coverage-v8": "^4.0.16",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
