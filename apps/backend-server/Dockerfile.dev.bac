# syntax=docker/dockerfile:1.7
FROM node:24-alpine

WORKDIR /repo

# pnpm via corepack
RUN corepack enable
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

# (często potrzebne na alpine dla paczek natywnych)
RUN apk add --no-cache libc6-compat

# --- install deps from MONOREPO ROOT so workspace:* works ---
# copy only manifests first for better caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# if you have it, it's important (registry/auth, shamefully-hoist, etc.)

# copy workspace manifests that affect dependency graph
COPY apps/backend-server/package.json apps/backend-server/package.json

# IMPORTANT: your backend depends on these workspace packages:
COPY packages/trpc/package.json packages/trpc/package.json
COPY packages/vitest-config/package.json packages/vitest-config/package.json

# If you have more internal workspace deps, add their package.json too.

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store && \
    pnpm install --frozen-lockfile

# now copy the actual sources (dev mode needs them)
COPY . .

# run dev for this workspace
EXPOSE 2022
CMD ["pnpm", "--filter", "@integral-2025-app/backend-server", "dev"]
