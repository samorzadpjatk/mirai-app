# syntax=docker/dockerfile:1.7

FROM node:24-alpine AS base
WORKDIR /repo

# pnpm via corepack (recommended)
RUN corepack enable
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

# (czasem potrzebne dla natywnych paczek na alpine)
RUN apk add --no-cache libc6-compat

# ---------- PRUNE ----------
# Tworzy ./out (przycięty lockfile + tylko potrzebne workspace'y)
FROM base AS pruner
COPY . .
# backend-server = nazwa workspace'a (często z package.json "name")
RUN pnpm dlx turbo@latest prune @integral-2025-app/backend-server --docker

# ---------- DEPS (dev deps for build) ----------
FROM base AS deps
# tylko pliki potrzebne do instalacji deps
COPY --from=pruner /repo/out/json/ ./

# cache pnpm store (zgodne z zaleceniami pnpm pod docker)
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store && \
    pnpm install --frozen-lockfile

# ---------- BUILD ----------
FROM base AS build
COPY --from=deps /repo/ ./
COPY --from=pruner /repo/out/full/ ./
# buduj tylko backend-server (dostosuj jeśli masz inne script-nazwy)
run pnpm --filter @integral-2025-app/@integral-2025-app/backend-server build

# ---------- RUNTIME ----------
FROM node:24-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production

# jeśli używasz runtime-only deps, zwykle chcesz prod install:
RUN corepack enable
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

# instalacja tylko prod deps na przyciętym json/
COPY --from=pruner /repo/out/json/ ./
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store && \
    pnpm install --frozen-lockfile --prod

# skopiuj zbudowany output aplikacji
# (zakładam, że TS build daje np. apps/backend-server/dist)
COPY --from=build /repo/apps/backend-server/dist ./dist

EXPOSE 2022
CMD ["node", "dist/index.js"]
