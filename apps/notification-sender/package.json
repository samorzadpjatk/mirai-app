{
  "name": "@mirai-app/notification-sender",
  "version": "0.1.0",
  "nx": { "tags": ["type:app", "scope:worker"] },
  "private": true,
  "license": "AGPL-3.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun --enable-source-maps src/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bunx --bun vitest --run --changed",
    "test:ci": "bunx --bun vitest run --coverage",
    "test:watch": "vitest",
    "clean": "rm -rf node_modules"
  },
  "dependencies": {
    "@mirai-app/supabase": "workspace:*",
    "@mirai-app/orpc": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@vitest/coverage-istanbul": "^4.1.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
