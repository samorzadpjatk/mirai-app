{
  "name": "@mirai-app/web",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "typecheck": "astro check && tsc --noEmit",
    "test": "bun test --preload ./test-setup.ts",
