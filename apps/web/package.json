{
  "name": "@integral-2025-app/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "eslint . && tsc --noEmit",
    "dev": "next dev -p 11000",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "preview": "next build && next start -p 11001",
    "start": "next start -p 11001",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:ci": "vitest run --silent --no-coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@integral-2025-app/auth": "workspace:*",
    "@integral-2025-app/common-types": "workspace:*",
    "@integral-2025-app/db": "workspace:*",
    "@integral-2025-app/supabase": "workspace:*",
    "@integral-2025-app/trpc": "workspace:*",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.2.1",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@trpc/server": "^11.7.2",
    "date-fns": "^4.1.0",
    "next": "^15.5.7",
    "next-themes": "^0.4.6",
    "react": "19.2.1",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1",
    "superjson": "^2.2.6",
    "web-push": "^3.6.7",
    "workbox-webpack-plugin": "^7.4.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "eslint-config-next": "^15.5.7",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "ct3aMetadata": {
    "initVersion": "7.39.3"
  }
}
