    "test:coverage": "bun test --coverage --preload ./test-setup.ts"
  },
  "dependencies": {
    "@astrojs/node": "^10.0.4",
    "@astrojs/react": "^5.0.2",
    "@mirai-app/adapters": "workspace:*",
