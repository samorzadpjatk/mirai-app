{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* Next.js specific */
    "lib": ["dom", "dom.iterable", "ES2022"],
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "verbatimModuleSyntax": true,
    "plugins": [{ "name": "next" }],

    /* Path Aliases */
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"],
      "@auth/core/*": [
        "../../node_modules/.pnpm/@auth+core@0.37.2/node_modules/@auth/core/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.cjs",
    "**/*.js",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "public/sw.js",
    "public/sw-dev.js",
    "public/workbox-*.js",
    "public/sw.js.map"
  ]
}