# Admin Web Environment Variables
# Copy this file to .env and fill in the values for local development

# =============================================================================
# Better Auth Configuration
# =============================================================================

# Better Auth API endpoint URL
# This is where the Better Auth server is running
PUBLIC_BETTER_AUTH_URL=http://localhost:4000/api/auth

# =============================================================================
# GraphQL Configuration
# =============================================================================

# GraphQL HTTP endpoint URL
PUBLIC_GRAPHQL_URL=http://localhost:4000/api/graphql

# GraphQL WebSocket URL for real-time subscriptions
PUBLIC_GRAPHQL_WS_URL=ws://localhost:4000/api/graphql

# =============================================================================
# SeaweedFS Storage Configuration
# =============================================================================

# SeaweedFS Filer TUS endpoint for resumable file uploads
PUBLIC_SEAWEEDFS_TUS_URL=http://localhost:7333/tus

# SeaweedFS S3 endpoint for direct file access
PUBLIC_SEAWEEDFS_S3_URL=http://localhost:8333

# =============================================================================
# App Configuration
# =============================================================================

# Public URL of the admin web application
PUBLIC_APP_URL=http://localhost:4321

# =============================================================================
# Legacy Variables (to be removed after migration)
# =============================================================================

# Supabase URL (legacy - will be removed)
PUBLIC_SUPABASE_URL=http://localhost:8000

# Supabase Anonymous Key (legacy - will be removed)
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbzEiLCAiZXhwIjogMTc5OTUzNTYwMH0.

# tRPC API URL (legacy - will be removed)
PUBLIC_TRPC_API_URL=http://localhost:2022/api/trpc

# tRPC WebSocket URL (legacy - will be removed)
PUBLIC_TRPC_WS_URL=ws://localhost:2022/api/trpc
