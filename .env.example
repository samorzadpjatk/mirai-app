# Authentik Provider
AUTHENTIK_ISSUER="http://localhost:9000/application/o/pjapp-dev/"
AUTHENTIK_SERVICE_ACCOUNT_TOKEN="your-authentik-service-account-token"

# Supabase Auth
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SERVICE_ROLE_KEY="your-service-role-key"
NEXT_PUBLIC_SUPABASE_URL="http://localhost:8000"

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="postgresql://postgres.your-tenant-id:your-super-secret-and-long-postgres-password@localhost:5432/postgres"

ADMIN_ROLE="PJAPP Admin"
MODERATOR_ROLE="PJAPP Moderator"
TECH_ROLE="PJAPP Tech"
SERVICE_ACCOUNT_ROLE="PJAPP SA"

# MinIO (S3-compatible) for Supabase Storage
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"
MINIO_REGION="pl-waw-1"
MINIO_BUCKET="supabase-storage"
