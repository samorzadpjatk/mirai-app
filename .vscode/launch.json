    {
      "name": "Debug: Notification Sender",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["--watch", "src/index.ts"],
      "cwd": "${workspaceFolder}/apps/notification-sender",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
