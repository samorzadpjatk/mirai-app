{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: Backend Server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["--watch", "src/index.ts"],
      "cwd": "${workspaceFolder}/apps/backend-server",
      "console": "integratedTerminal",
