      "problemMatcher": []
    },
    {
      "label": "Format: Write",
      "type": "shell",
      "command": "bun run format:write",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "bun run test",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "bun run build",
      "group": "build",
      "problemMatcher": []
