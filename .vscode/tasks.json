      "problemMatcher": []
    },
    {
      "label": "Dev: Backend",
      "type": "shell",
      "command": "bun run dev:backend",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Dev: Native",
      "type": "shell",
      "command": "bun run dev:native",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "bun run lint",
      "group": "test",
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "Typecheck",
      "type": "shell",
      "command": "bun run typecheck",
