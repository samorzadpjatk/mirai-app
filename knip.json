{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "apps/*": {
      "entry": ["src/index.ts", "src/**/*.test.ts", "src/**/*.test.tsx"],
      "project": ["src/**/*.ts", "src/**/*.tsx"]
    },
    "packages/*": {
      "entry": ["src/index.ts", "src/**/*.test.ts", "src/**/*.test.tsx"],
      "project": ["src/**/*.ts", "src/**/*.tsx"]
    }
  },
  "ignore": [
    "**/vitest.setup.ts",
    "**/vitest.config.ts",
    "**/*.d.ts",
    "scripts/**"
  ],
  "ignoreDependencies": [
    "@commitlint/config-conventional",
    "@testing-library/jest-dom",
    "picocolors"
  ]
}
