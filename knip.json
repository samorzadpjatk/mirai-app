{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "apps/native": {
      "entry": ["src/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["tailwindcss", "expo-system-ui", "expo-updates", "@babel/plugin-transform-react-jsx", "react-native-css-interop"]
    },
    "apps/backend-server": {
      "project": ["src/**/*.ts"]
    },
    "apps/notification-sender": {
      "project": ["src/**/*.ts"]
    },
    "apps/seed": {
      "project": ["src/**/*.ts"]
    },
    "packages/auth": {
      "project": ["src/**/*.ts", "src/**/*.tsx"]
    },
    "packages/db": {
      "project": ["src/**/*.ts"]
    },
    "packages/orpc": {
      "project": ["src/**/*.ts", "src/**/*.tsx"],
      "ignoreDependencies": ["pino"]
    },
    "packages/shared": {
      "project": ["src/**/*.ts"]
    },
    "packages/supabase": {
      "project": ["src/**/*.ts", "src/**/*.tsx"]
    }
  },
  "ignore": [
    "**/vitest.config.ts",
    "commitlint.config.cjs",
    "scripts/**"
  ],
  "ignoreBinaries": [
    "jest"
  ],
  "ignoreDependencies": [
    "@commitlint/config-conventional",
    "@babel/runtime"
  ]
}
